+      const proc = await lazy.Subprocess.call({
+        command: ffprobe,
+        arguments: [
+          "-v",
+          "error",
+          "-show_entries",
+          "format=start_time:stream=codec_type,codec_name,profile,width,height,time_base",
+          "-of",
+          "json",
+          file,
+        ],
+      });
+      let out = "";
+      for (;;) {
+        const chunk = await proc.stdout.readString();
+        if (!chunk) {
+          break;
+        }
+        out += chunk;
+      }
