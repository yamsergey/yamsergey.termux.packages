+  async _runFfmpeg(ffmpeg, args, durationMs, report) {
+    const proc = await lazy.Subprocess.call({
+      command: ffmpeg,
+      arguments: [
+        "-nostdin",
+        "-hide_banner",
+        "-loglevel",
+        "error",
+        "-nostats",
+        "-progress",
+        "pipe:1",
+        "-y",
+        ...args,
+      ],
+      stderr: "stdout",
