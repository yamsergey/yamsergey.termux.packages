+});
+
+export class TermuxMediaRecordingParent extends JSWindowActorParent {
+  receiveMessage(message) {
+    if (message.name === "TermuxMediaRecording:State") {
+      // Kept for didDestroy, when the browsing context may be gone already.
+      this._topId = this.browsingContext?.top?.id ?? this._topId;
+      this._innerWindowId =
+        this.manager?.innerWindowId ?? this._innerWindowId;
+      lazy.TermuxMediaRecording.onContentState(this, message.data);
+    }
+  }
+
+  didDestroy() {
+    if (this._topId !== undefined && this._innerWindowId !== undefined) {
+      lazy.TermuxMediaRecording.onWindowGone(this._topId, this._innerWindowId);
+    }
+  }
+}
