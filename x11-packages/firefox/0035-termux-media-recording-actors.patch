+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Termux media recording (yamsergey.termux.packages patch 0035).
+ *
+ * Forwards the "termux-media-recording" observer notifications that
+ * SourceBuffer fires (patch 0034; subject: the window, data: JSON) to the
+ * parent, and rewinds the page's MSE media elements on request.
+ */
+export class TermuxMediaRecordingChild extends JSWindowActorChild {
+  observe(subject, topic, data) {
+    if (topic !== "termux-media-recording") {
+      return;
+    }
+    let payload;
+    try {
+      payload = JSON.parse(data);
+    } catch (e) {
+      return;
+    }
+    const doc = this.document;
+    payload.title = doc?.title || "";
+    payload.url = doc?.location?.href || "";
+    this.sendAsyncMessage("TermuxMediaRecording:State", payload);
+  }
+
+  receiveMessage(message) {
+    if (message.name !== "TermuxMediaRecording:SeekToStart") {
+      return;
+    }
+    const doc = this.document;
+    if (!doc) {
+      return;
+    }
+    for (const element of doc.querySelectorAll("video, audio")) {
+      try {
+        const src = element.currentSrc || element.src || "";
+        if (element.srcObject || src.startsWith("blob:")) {
+          element.currentTime = 0;
+        }
+      } catch (e) {
+        // Not seekable right now; the recording simply starts from here.
+      }
+    }
+  }
+}
