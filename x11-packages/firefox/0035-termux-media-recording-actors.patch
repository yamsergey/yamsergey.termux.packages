+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Termux media recording (yamsergey.termux.packages patch 0035).
+ *
+ * Parent-process state for the per-tab media recorder. The content side
+ * (SourceBuffer, patch 0034) reports every MSE track of a document through the
+ * TermuxMediaRecording JSWindowActor; this module keeps one session per
+ * top-level browsing context, flips the BrowsingContext's
+ * `termuxMediaRecording` flag to start and stop, and tells its listeners:
+ *
+ *   "stream-detected"  (state)  a tab gained its first MSE track
+ *   "state-changed"    (state)  anything else changed (at most ~1/s per track)
+ *
+ * The toolbar button (browser/components/termux) and the WebDriver BiDi
+ * "termux" module are the consumers.
+ */
+
+const lazy = {};
+
+ChromeUtils.defineESModuleGetters(lazy, {
+  Subprocess: "resource://gre/modules/Subprocess.sys.mjs",
+});
+
+const PREF_DIR = "media.termux.recording.dir";
+const PREF_FFMPEG = "media.termux.recording.ffmpeg";
+
+// Merge progress: the share of the bar for measuring the parts, and the run
+// time of a stream copy relative to the media's duration.
+const MEASURE_SHARE = 0.1;
+const COPY_COST = 0.02;
+const PREF_KEEP_PARTS = "media.termux.recording.keepParts";
+// Rescale H.264 parts of another size than the main rendition in the merge.
+const PREF_RESCALE = "media.termux.recording.rescaleParts";
+// While a recording runs, Firefox's background throttling is relaxed so that
+// a hidden window keeps streaming at full speed: no decoder suspension,
+// timers at full rate, hidden windows painted at 30 fps, no lowering of the
+// process priority. A pref the user set themselves is left alone; the others
+// are set for the duration and cleared when the last recording stops. The
+// names set are remembered in PREF_APPLIED, so a crash cannot leave them.
+const BACKGROUND_PREFS = [
+  ["media.suspend-background-video.enabled", false],
+  ["dom.timeout.enable_budget_timer_throttling", false],
+  ["dom.min_background_timeout_value", 100],
+  ["dom.min_background_timeout_value_without_budget_throttling", 100],
+  ["layout.throttled_frame_rate", 30],
+  ["dom.ipc.processPriorityManager.enabled", false],
+];
+const PREF_APPLIED = "media.termux.recording.appliedPrefs";
+// One folder per recording, named "<start time> <tab title>", holding its
+// parts while it runs and the merged file and summary afterwards.
+const PREF_FOLDERS = "media.termux.recording.folderPerRecording";
+
+/**
+ * The folder name of a recording: its local start time and the tab title,
+ * reduced to letters, digits, spaces and ._- (a single path component).
+ */
+function folderName(startedAt, title, origin) {
+  const d = new Date(startedAt);
+  const pad = n => String(n).padStart(2, "0");
+  const stamp =
+    `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}_` +
+    `${pad(d.getHours())}-${pad(d.getMinutes())}-${pad(d.getSeconds())}`;
+  const label = String(title || origin || "recording")
+    .replace(/[^\p{L}\p{N} ._-]+/gu, " ")
+    .replace(/\s+/g, " ")
+    .trim()
+    .slice(0, 60)
+    .replace(/^[ .]+|[ .]+$/g, "");
+  return label ? `${stamp} ${label}` : stamp;
+}
+
+class Listeners {
+  #fns = new Set();
+
+  add(fn) {
+    this.#fns.add(fn);
+  }
+
+  remove(fn) {
+    this.#fns.delete(fn);
+  }
+
+  emit(...args) {
+    for (const fn of [...this.#fns]) {
+      try {
+        fn(...args);
+      } catch (e) {
+        console.error("TermuxMediaRecording listener failed", e);
+      }
+    }
+  }
+}
+
+/**
+ * Everything known about the media in one top-level browsing context.
+ */
+class Session {
+  // topBrowsingContext is null for a saved recording merged again.
+  constructor(topBrowsingContext) {
+    this.browsingContext = topBrowsingContext;
+    this.browsingContextId = topBrowsingContext?.id ?? 0;
+    // `${innerWindowId}:${trackId}` -> last report from the content process.
+    this.tracks = new Map();
+    // idle | recording | paused | saving | ready | partial | error
+    this.status = "idle";
+    this.startedAt = null;
+    this.stoppedAt = null;
+    this.dir = "";
+    this.title = "";
+    this.url = "";
+    this.origin = "";
+    this.summaryPath = null;
+    // The recording's own folder name (PREF_FOLDERS), "" without one.
+    this.folder = "";
+    // The name of the file and the summary when it is known up front (a
+    // saved recording merged again); otherwise _prefixOf works it out.
+    this.prefix = "";
+    // Merge (status "saving" and after). stage is {name, index, count,
+    // kind}: measuring | rescaling | joining (kind: the track kind) |
+    // writing, index counted from 1.
+    this.progress = 0;
+    this.stage = null;
+    this.mergeStartedAt = null;
+    this.output = null;
+    this.outputBytes = 0;
+    this.endedByPage = false;
+    this.mergeError = null;
+    // Reports from the content side after a stop are not part of this
+    // recording any more.
+    this.frozenTracks = null;
+    // The summary of a saved recording merged again (mergeSavedRecording);
+    // it stands for the tracks.
+    this.restored = null;
+  }
+}
+
+// A part as the dump names it: <prefix>-<kind>-<track id>-p<NNN>.<ext>.
+const PART_NAME = /^(.+)-(video|audio)-(\d+)-p(\d{3,})\.(mp4|webm)$/;
+
+/**
+ * A summary for parts that were never merged (the merge was interrupted, or
+ * the recording predates the summaries): one track per kind and track id.
+ */
+function summaryOfParts(prefix, dir, names) {
+  const tracks = new Map();
+  for (const name of names.sort()) {
+    const match = PART_NAME.exec(name);
+    if (!match) {
+      continue;
+    }
+    const key = `${match[2]}-${match[3]}`;
+    if (!tracks.has(key)) {
+      tracks.set(key, { kind: match[2], startUs: -1, files: [] });
+    }
+    tracks.get(key).files.push(PathUtils.join(dir, name));
+  }
+  // The parts' own prefix is <seconds>-<host>; a recording's folder is
+  // named "<date>_<time> <title>".
+  const first = PART_NAME.exec(names.find(n => PART_NAME.test(n)) || "");
+  const stamp = /^(\d{9,11})-(.+)$/.exec(first ? first[1] : prefix);
+  const folder = /^\d{4}-\d\d-\d\d_\d\d-\d\d-\d\d (.+)$/.exec(prefix);
+  return {
+    status: "saving",
+    title: folder ? folder[1] : "",
+    url: "",
+    origin: stamp ? stamp[2] : "",
+    startedAt: stamp ? Number(stamp[1]) * 1000 : null,
+    stoppedAt: null,
+    capturedMs: 0,
+    encrypted: false,
+    error: null,
+    output: null,
+    outputBytes: 0,
+    tracks: [...tracks.values()],
+    files: [...tracks.values()].flatMap(t => t.files),
+  };
+}
+
+function fileName(track, part) {
+  return `${track.dir}/${track.base}-p${String(part).padStart(3, "0")}.${track.ext}`;
+}
+
+function trackFiles(track) {
+  const files = [];
+  if (track.base && track.dir) {
+    for (let part = 1; part <= (track.parts || 0); part++) {
+      files.push(fileName(track, part));
+    }
+  }
+  return files;
+}
+
+/**
+ * Puts the measured parts of one kind in media order and leaves out those
+ * that only repeat media covered already: a page may stream one program
+ * through two players (a site's mini player next to the main one), each with
+ * its own buffer, and the dump cuts a part at every seek, rendition change
+ * or discontinuity. Parts without a readable start keep their append order
+ * at the end. Also picks the main rendition (the size with the most media)
+ * and lists the H.264 parts of another size, to be rescaled to it.
+ */
+function planParts(parts) {
+  const timed = parts
+    .filter(p => p.start !== null)
+    .sort((a, b) => a.start - b.start || a.order - b.order);
+  const untimed = parts.filter(p => p.start === null);
+  const kept = [];
+  const contained = [];
+  let coveredEnd = -Infinity;
+  for (const part of timed) {
+    const end = part.start + part.span;
+    if (end <= coveredEnd + 0.1) {
+      contained.push(part);
+      continue;
+    }
+    kept.push(part);
+    coveredEnd = Math.max(coveredEnd, end);
+  }
+  const ordered = [...kept, ...untimed];
+  const bySize = new Map();
+  for (const p of ordered) {
+    if (p.width && p.height) {
+      const key = `${p.width}x${p.height}`;
+      bySize.set(key, (bySize.get(key) || 0) + p.span);
+    }
+  }
+  let main = null;
+  for (const [key, total] of bySize) {
+    if (!main || total > main.total) {
+      const [width, height] = key.split("x").map(Number);
+      main = { width, height, total, codec: "", profile: "", timescale: 0 };
+    }
+  }
+  let rescale = [];
+  if (main) {
+    const sample = ordered.find(
+      p => p.width === main.width && p.height === main.height
+    );
+    main.codec = sample.codec;
+    main.profile = sample.profile;
+    main.timescale = sample.timescale;
+    rescale = ordered.filter(
+      p =>
+        p.width &&
+        p.height &&
+        (p.width !== main.width || p.height !== main.height) &&
+        p.codec === "h264" &&
+        main.codec === "h264"
+    );
+  }
+  return { parts: ordered, contained, main, rescale };
+}
+
+const REPORT_STATES = new Set(["idle", "recording", "error", "ended"]);
+// What SourceBuffer::UpdateDumpState generates: <time>-<host>-<kind>-<id>.
+const BASE_NAME = /^\d{1,20}-[A-Za-z0-9._-]{1,200}-(video|audio)-\d{1,10}$/;
+const EXTENSIONS = new Set(["mp4", "webm"]);
+
+/**
+ * A report comes from a web content process, which an attacker may control
+ * (the actor is safeForUntrustedWebProcess). Keep only the expected shape and
+ * never take a path from it: the directory is this process's pref and the
+ * base name has to match the pattern SourceBuffer produces, else the track
+ * has no files.
+ */
+function sanitizeReport(raw) {
+  if (!raw || typeof raw !== "object") {
+    return null;
+  }
+  const str = (value, max) =>
+    typeof value === "string" ? value.slice(0, max) : "";
+  const int = (value, fallback = 0) =>
+    typeof value === "number" && Number.isFinite(value)
+      ? Math.trunc(value)
+      : fallback;
+  const id = int(raw.id, -1);
+  if (id < 0 || !REPORT_STATES.has(raw.state)) {
+    return null;
+  }
+  const base = str(raw.base, 256);
+  const ext = str(raw.ext, 8);
+  const hasFiles = BASE_NAME.test(base) && EXTENSIONS.has(ext);
+  const dir = Services.prefs.getStringPref(PREF_DIR, "").replace(/\/+$/, "");
+  return {
+    id,
+    state: raw.state,
+    kind: raw.kind === "audio" ? "audio" : "video",
+    mime: str(raw.mime, 256),
+    codec: str(raw.codec, 128),
+    encrypted: !!raw.encrypted,
+    width: Math.max(0, int(raw.width)),
+    height: Math.max(0, int(raw.height)),
+    rate: Math.max(0, int(raw.rate)),
+    channels: Math.max(0, int(raw.channels)),
+    noDir: !!raw.noDir,
+    writeError: !!raw.writeError,
+    bytes: Math.max(0, int(raw.bytes)),
+    parts: hasFiles ? Math.min(9999, Math.max(0, int(raw.parts))) : 0,
+    startUs: int(raw.startUs, -1),
+    endUs: int(raw.endUs, -1),
+    recordedUs: Math.max(0, int(raw.recordedUs)),
+    skippedSegments: Math.max(0, int(raw.skippedSegments)),
+    keyframeWaits: Math.max(0, int(raw.keyframeWaits)),
+    emptySegments: Math.max(0, int(raw.emptySegments)),
+    dir: hasFiles ? dir : "",
+    base: hasFiles ? base : "",
+    ext: hasFiles ? ext : "",
+    title: str(raw.title, 512),
+    url: str(raw.url, 2048),
+  };
+}
+
+export const TermuxMediaRecording = {
+  _sessions: new Map(),
+  _history: [],
+  // Saved recordings merged again: summary path -> Session.
+  _remerging: new Map(),
+  _listeners: new Map([
+    ["stream-detected", new Listeners()],
+    ["state-changed", new Listeners()],
+  ]),
+
+  on(event, fn) {
+    this._listeners.get(event)?.add(fn);
+  },
+
+  off(event, fn) {
+    this._listeners.get(event)?.remove(fn);
+  },
+
+  _emit(event, session) {
+    this._listeners.get(event)?.emit(this._stateOf(session));
+  },
+
+  /**
+   * The recorder's view of one top-level browsing context, or null when no
+   * media was seen there and nothing was started.
+   */
+  getState(browsingContext) {
+    const session = this._sessionFor(browsingContext, false);
+    return session ? this._stateOf(session) : null;
+  },
+
+  /**
+   * Finished recordings (newest last) plus the ones running or saving now.
+   */
+  listRecordings() {
+    const live = [];
+    for (const session of this._sessions.values()) {
+      if (
+        session.status === "recording" ||
+        session.status === "paused" ||
+        session.status === "saving"
+      ) {
+        live.push(this._stateOf(session));
+      }
+    }
+    for (const session of this._remerging.values()) {
+      live.push(this._stateOf(session));
+    }
+    return [...this._history, ...live];
+  },
+
+  /**
+   * The recordings found in the recording directory, newest first: one per
+   * summary (<name>.json) and one per group of parts without a summary, in a
+   * recording's own folder or, for the flat layout, in the directory itself.
+   * `path` is the summary's path (where it would be for parts without one)
+   * and names the recording in mergeSavedRecording and deleteSavedRecording.
+   * `thumbnail` is <name>.jpg, a frame the merge saved, or null.
+   * A recording running or merging now is listed by listRecordings instead.
+   */
+  async listSavedRecordings() {
+    const busy = this._busySummaries();
+    const rows = [];
+    for (const entry of (await this._scanSaved()).values()) {
+      if (busy.has(entry.path)) {
+        continue;
+      }
+      rows.push(await this._savedRow(entry));
+    }
+    rows.sort((a, b) => (b.startedAt || 0) - (a.startedAt || 0));
+    return rows;
+  },
+
+  /**
+   * Merges the parts of a saved recording that has no file yet (or whose
+   * merge failed). Returns at once, like stop(); "state-changed" reports the
+   * progress with the recording's summaryPath.
+   */
+  async mergeSavedRecording(path) {
+    const entry = (await this._scanSaved()).get(path);
+    if (!entry) {
+      throw new Error("no such recording");
+    }
+    if (this._busySummaries().has(path)) {
+      throw new Error("the recording is being saved");
+    }
+    const { summary } = entry;
+    const session = new Session(null);
+    session.restored = summary;
+    session.browsingContextId = summary.browsingContextId ?? 0;
+    session.status = "saving";
+    session.title = summary.title || "";
+    session.url = summary.url || "";
+    session.origin = summary.origin || "";
+    session.startedAt = summary.startedAt ?? null;
+    session.stoppedAt = summary.stoppedAt ?? null;
+    session.endedByPage = !!summary.endedByPage;
+    session.dir = entry.dir;
+    session.folder = entry.folder ? PathUtils.filename(entry.folder) : "";
+    session.prefix = entry.prefix;
+    session.summaryPath = path;
+    session.stage = { name: "measuring", index: 0, count: 0 };
+    session.mergeStartedAt = Date.now();
+    this._remerging.set(path, session);
+    this._emit("state-changed", session);
+    this._merge(session)
+      .catch(e => {
+        console.error("TermuxMediaRecording: merge failed", e);
+        return this._finishMerge(session, { error: String(e?.message || e) });
+      })
+      .finally(() => this._remerging.delete(path));
+    return this._stateOf(session);
+  },
+
+  /**
+   * Deletes a saved recording: its folder, or in the flat layout the files
+   * that carry its name (the file, the summary, the parts and the merge's
+   * working files).
+   */
+  async deleteSavedRecording(path) {
+    const entry = (await this._scanSaved()).get(path);
+    if (!entry) {
+      throw new Error("no such recording");
+    }
+    if (this._busySummaries().has(path)) {
+      throw new Error("the recording is being saved");
+    }
+    if (entry.folder) {
+      await IOUtils.remove(entry.folder, { recursive: true });
+      return;
+    }
+    for (const name of entry.names) {
+      await IOUtils.remove(PathUtils.join(entry.dir, name), {
+        ignoreAbsent: true,
+      });
+    }
+  },
+
+  // Summary paths of the recordings running or being merged now.
+  _busySummaries() {
+    const busy = new Set(this._remerging.keys());
+    for (const session of this._sessions.values()) {
+      if (
+        session.status === "recording" ||
+        session.status === "paused" ||
+        session.status === "saving"
+      ) {
+        busy.add(`${session.dir}/${this._prefixOf(session)}.json`);
+      }
+    }
+    return busy;
+  },
+
+  /**
+   * path -> {path, dir, folder, prefix, names, summary, saved} for the
+   * recording directory: its own folders (one recording each) and the flat
+   * layout's files grouped by name.
+   */
+  async _scanSaved() {
+    const root = Services.prefs.getStringPref(PREF_DIR, "").replace(/\/+$/, "");
+    const entries = new Map();
+    if (!root) {
+      return entries;
+    }
+    const list = async dir => {
+      try {
+        const names = [];
+        for (const child of await IOUtils.getChildren(dir)) {
+          const info = await IOUtils.stat(child);
+          names.push({ name: PathUtils.filename(child), type: info.type });
+        }
+        return names;
+      } catch (e) {
+        return [];
+      }
+    };
+    const add = async (dir, folder, prefix, names) => {
+      const path = PathUtils.join(dir, `${prefix}.json`);
+      let summary = null;
+      if (names.includes(`${prefix}.json`)) {
+        try {
+          summary = await IOUtils.readJSON(path);
+        } catch (e) {
+          console.warn(`TermuxMediaRecording: cannot read ${path}`, e);
+        }
+      }
+      const saved = !!summary;
+      if (!summary) {
+        summary = summaryOfParts(prefix, dir, names);
+        if (!summary.files.length) {
+          return;
+        }
+      }
+      entries.set(path, { path, dir, folder, prefix, names, summary, saved });
+    };
+
+    const top = await list(root);
+    const flat = top.filter(c => c.type === "regular").map(c => c.name);
+    for (const child of top) {
+      if (child.type !== "directory") {
+        continue;
+      }
+      // A recording's own folder holds <folder>.json once merged; before
+      // that only its parts.
+      const folder = PathUtils.join(root, child.name);
+      const names = (await list(folder))
+        .filter(c => c.type === "regular")
+        .map(c => c.name);
+      if (names.includes(`${child.name}.json`) || names.some(n => PART_NAME.test(n))) {
+        await add(folder, folder, child.name, names);
+      }
+    }
+    // The flat layout: <prefix>.json, <prefix>.<ext>, <prefix>-<kind>-...
+    const prefixes = new Set();
+    for (const name of flat) {
+      const part = PART_NAME.exec(name);
+      if (part) {
+        prefixes.add(part[1]);
+      } else if (name.endsWith(".json")) {
+        prefixes.add(name.slice(0, -".json".length));
+      }
+    }
+    for (const prefix of prefixes) {
+      const names = flat.filter(
+        n => n.startsWith(`${prefix}.`) || n.startsWith(`${prefix}-`)
+      );
+      await add(root, null, prefix, names);
+    }
+    return entries;
+  },
+
+  /** What listSavedRecordings reports for one recording. */
+  async _savedRow(entry) {
+    const { summary } = entry;
+    const inside = file =>
+      typeof file === "string" && PathUtils.parent(file) === entry.dir;
+    let output = null;
+    let outputBytes = 0;
+    if (inside(summary.output)) {
+      try {
+        outputBytes = (await IOUtils.stat(summary.output)).size;
+        output = summary.output;
+      } catch (e) {
+        // Deleted or moved.
+      }
+    }
+    const parts = [];
+    let partBytes = 0;
+    for (const file of Array.isArray(summary.files) ? summary.files : []) {
+      if (!inside(file)) {
+        continue;
+      }
+      try {
+        partBytes += (await IOUtils.stat(file)).size;
+        parts.push(file);
+      } catch (e) {
+        // Removed by the merge.
+      }
+    }
+    const tracks = Array.isArray(summary.tracks) ? summary.tracks : [];
+    const sizes = [
+      ...new Set(
+        tracks
+          .filter(t => t.kind === "video" && t.width && t.height)
+          .map(t => `${t.width}x${t.height}`)
+      ),
+    ];
+    let status;
+    if (output) {
+      status = summary.status === "partial" ? "partial" : "ready";
+    } else if (parts.length) {
+      // Never merged: stopped by a closing browser, or the merge failed.
+      status = "unmerged";
+    } else {
+      status = "error";
+    }
+    return {
+      path: entry.path,
+      dir: entry.dir,
+      folder: entry.folder,
+      hasSummary: entry.saved,
+      status,
+      title: String(summary.title || ""),
+      url: String(summary.url || ""),
+      origin: String(summary.origin || ""),
+      startedAt: Number(summary.startedAt) || null,
+      stoppedAt: Number(summary.stoppedAt) || null,
+      capturedMs: Number(summary.capturedMs) || 0,
+      encrypted: !!summary.encrypted,
+      error: summary.error ? String(summary.error) : null,
+      output,
+      outputBytes,
+      thumbnail: entry.names.includes(`${entry.prefix}.jpg`)
+        ? PathUtils.join(entry.dir, `${entry.prefix}.jpg`)
+        : null,
+      parts: parts.length,
+      partBytes,
+      sizes,
+    };
+  },
+
+  async start(browsingContext) {
+    let session = this._sessionFor(browsingContext, true);
+    if (session.status === "saving") {
+      throw new Error("the previous recording is still being saved");
+    }
+    if (session.status === "recording" || session.status === "paused") {
+      throw new Error("a recording is already running");
+    }
+    if (session.status !== "idle") {
+      // Record again in the same tab: a fresh session, so that nothing of the
+      // finished one (its parts were deleted by the merge) carries over. The
+      // tracks are kept as known streams; their files are reported anew once
+      // the dump is on. The finished recording lives on in the history.
+      const fresh = new Session(session.browsingContext);
+      for (const [key, track] of session.tracks) {
+        if (track.state === "ended") {
+          continue;
+        }
+        fresh.tracks.set(key, {
+          ...track,
+          bytes: 0,
+          parts: 0,
+          startUs: -1,
+          endUs: -1,
+          recordedUs: 0,
+          skippedSegments: 0,
+          keyframeWaits: 0,
+          emptySegments: 0,
+          dir: "",
+          base: "",
+          ext: "",
+        });
+      }
+      fresh.title = session.title;
+      fresh.url = session.url;
+      fresh.origin = session.origin;
+      session = fresh;
+      this._sessions.set(session.browsingContextId, session);
+    }
+    const dir = Services.prefs.getStringPref(PREF_DIR, "");
+    if (!dir) {
+      throw new Error(`${PREF_DIR} is not set`);
+    }
+    await IOUtils.makeDirectory(dir, {
+      createAncestors: true,
+      ignoreExisting: true,
+    });
+    session.startedAt = Date.now();
+    this._refreshMeta(session);
+    session.folder = Services.prefs.getBoolPref(PREF_FOLDERS, true)
+      ? folderName(session.startedAt, session.title, session.origin)
+      : "";
+    session.dir = session.folder
+      ? `${dir.replace(/\/+$/, "")}/${session.folder}`
+      : dir;
+    if (session.folder) {
+      await IOUtils.makeDirectory(session.dir, { ignoreExisting: true });
+    }
+    session.status = "recording";
+    session.stoppedAt = null;
+    session.summaryPath = null;
+    session.progress = 0;
+    session.stage = null;
+    session.mergeStartedAt = null;
+    session.output = null;
+    session.outputBytes = 0;
+    session.endedByPage = false;
+    session.mergeError = null;
+    session.frozenTracks = null;
+    this._applyBackgroundPrefs();
+    this._setFlag(session, true);
+    this._emit("state-changed", session);
+    return this._stateOf(session);
+  },
+
+  pause(browsingContext) {
+    const session = this._sessionFor(browsingContext, false);
+    if (!session || session.status !== "recording") {
+      return this.getState(browsingContext);
+    }
+    this._setPaused(session, true);
+    session.status = "paused";
+    this._emit("state-changed", session);
+    return this._stateOf(session);
+  },
+
+  resume(browsingContext) {
+    const session = this._sessionFor(browsingContext, false);
+    if (!session || session.status !== "paused") {
+      return this.getState(browsingContext);
+    }
+    this._setPaused(session, false);
+    session.status = "recording";
+    this._emit("state-changed", session);
+    return this._stateOf(session);
+  },
+
+  /**
+   * Stops the recording and merges its parts into one file. Returns as soon
+   * as the merge has started; "state-changed" reports the progress and the
+   * final "ready", "partial" or "error" status.
+   */
+  async stop(browsingContext) {
+    const session = this._sessionFor(browsingContext, false);
+    if (
+      !session ||
+      (session.status !== "recording" && session.status !== "paused")
+    ) {
+      return this.getState(browsingContext);
+    }
+    this._setFlag(session, false);
+    session.status = "saving";
+    this._restoreBackgroundPrefs();
+    session.stoppedAt = Date.now();
+    session.progress = 0;
+    session.stage = { name: "measuring", index: 0, count: 0 };
+    session.mergeStartedAt = session.stoppedAt;
+    // What was captured is fixed now; later reports belong to the next one.
+    session.frozenTracks = new Map(session.tracks);
+    await this._writeSummary(session, this._stateOf(session));
+    this._emit("state-changed", session);
+    this._merge(session).catch(e => {
+      console.error("TermuxMediaRecording: merge failed", e);
+      this._finishMerge(session, { error: String(e?.message || e) });
+    });
+    return this._stateOf(session);
+  },
+
+  /**
+   * Called by TermuxMediaRecordingParent for every report from a content
+   * process.
+   */
+  onContentState(actor, rawData) {
+    const data = sanitizeReport(rawData);
+    const browsingContext = actor.browsingContext;
+    if (!data || !browsingContext) {
+      return;
+    }
+    const top = browsingContext.top;
+    const innerWindowId = actor.manager?.innerWindowId ?? 0;
+    const key = `${innerWindowId}:${data.id}`;
+
+    if (data.state === "ended") {
+      const session = this._sessions.get(top.id);
+      const track = session?.tracks.get(key);
+      if (!track) {
+        return;
+      }
+      if (session.status === "recording" || session.status === "paused") {
+        // The buffer went away mid-recording: a page that replaces its
+        // player (a small and a large one, a reload of the stream) does this
+        // and feeds a new buffer right after. The files written so far stay
+        // part of the recording and the recording goes on; a page that goes
+        // away for good is handled in onWindowGone.
+        session.tracks.set(key, {
+          ...track,
+          state: "ended",
+          updatedAt: Date.now(),
+        });
+      } else {
+        session.tracks.delete(key);
+        if (
+          session.tracks.size === 0 &&
+          (session.status === "idle" || session.status === "error")
+        ) {
+          this._sessions.delete(top.id);
+        }
+      }
+      this._emit("state-changed", session);
+      return;
+    }
+
+    let session = this._sessions.get(top.id);
+    const finished =
+      session &&
+      (session.status === "ready" ||
+        session.status === "partial" ||
+        (session.status === "error" && session.output !== null));
+    if (!session) {
+      session = new Session(top);
+      this._sessions.set(top.id, session);
+    } else if (session.tracks.size === 0 && finished) {
+      // A new video after a finished recording in the same tab: start clean,
+      // the finished one lives on in the history.
+      session = new Session(top);
+      this._sessions.set(top.id, session);
+    }
+    const isNew = !session.tracks.has(key);
+    if (data.base && session.dir) {
+      // The parts are in the recording's folder (never a path from the
+      // content process: session.dir is built here from the pref).
+      data.dir = session.dir;
+    }
+    session.tracks.set(key, { ...data, key, updatedAt: Date.now() });
+    this._refreshMeta(session);
+    if (data.state === "error" && session.status === "recording") {
+      session.status = "error";
+    }
+    if (isNew) {
+      this._emit("stream-detected", session);
+    }
+    this._emit("state-changed", session);
+  },
+
+  /**
+   * Called by TermuxMediaRecordingParent when a window (its actor) is gone:
+   * navigation or a closed tab. Its buffers cannot report any more, so they
+   * count as ended; a recording with no live buffer left stops and keeps
+   * what was captured.
+   */
+  onWindowGone(topId, innerWindowId) {
+    const session = this._sessions.get(topId);
+    if (!session) {
+      return;
+    }
+    const prefix = `${innerWindowId}:`;
+    let changed = false;
+    for (const [key, track] of session.tracks) {
+      if (key.startsWith(prefix) && track.state !== "ended") {
+        session.tracks.set(key, {
+          ...track,
+          state: "ended",
+          updatedAt: Date.now(),
+        });
+        changed = true;
+      }
+    }
+    if (session.status === "recording" || session.status === "paused") {
+      const live = [...session.tracks.values()].some(t => t.state !== "ended");
+      if (!live && session.tracks.size) {
+        session.endedByPage = true;
+        this.stop(session.browsingContext).catch(console.error);
+        return;
+      }
+    } else if (session.status === "idle" || session.status === "error") {
+      for (const [key, track] of session.tracks) {
+        if (track.state === "ended") {
+          session.tracks.delete(key);
+          changed = true;
+        }
+      }
+      if (!session.tracks.size) {
+        this._sessions.delete(topId);
+        this._emit("state-changed", session);
+        return;
+      }
+    }
+    if (changed) {
+      this._emit("state-changed", session);
+    }
+  },
+
+  _applyBackgroundPrefs() {
+    const applied = new Set(
+      Services.prefs.getStringPref(PREF_APPLIED, "").split(",").filter(Boolean)
+    );
+    for (const [name, value] of BACKGROUND_PREFS) {
+      if (!applied.has(name) && Services.prefs.prefHasUserValue(name)) {
+        continue;
+      }
+      try {
+        if (typeof value === "boolean") {
+          Services.prefs.setBoolPref(name, value);
+        } else {
+          Services.prefs.setIntPref(name, value);
+        }
+        applied.add(name);
+      } catch (e) {
+        console.warn(`TermuxMediaRecording: cannot set ${name}`, e);
+      }
+    }
+    Services.prefs.setStringPref(PREF_APPLIED, [...applied].join(","));
+  },
+
+  _restoreBackgroundPrefs() {
+    for (const session of this._sessions.values()) {
+      if (session.status === "recording" || session.status === "paused") {
+        return;
+      }
+    }
+    for (const name of Services.prefs.getStringPref(PREF_APPLIED, "").split(",")) {
+      if (name) {
+        Services.prefs.clearUserPref(name);
+      }
+    }
+    Services.prefs.clearUserPref(PREF_APPLIED);
+  },
+
+  _sessionFor(browsingContext, create) {
+    if (!browsingContext) {
+      return null;
+    }
+    const top = browsingContext.top;
+    let session = this._sessions.get(top.id);
+    if (!session && create) {
+      session = new Session(top);
+      this._sessions.set(top.id, session);
+    }
+    return session || null;
+  },
+
+  _setFlag(session, value) {
+    try {
+      if (!session.browsingContext.isDiscarded) {
+        if (!value) {
+          session.browsingContext.termuxMediaRecordingPaused = false;
+        } else {
+          // Before the flag: SourceBuffer reads it when the dump turns on.
+          session.browsingContext.termuxMediaRecordingFolder = session.folder;
+        }
+        session.browsingContext.termuxMediaRecording = value;
+      }
+    } catch (e) {
+      console.error("TermuxMediaRecording: cannot set the flag", e);
+    }
+  },
+
+  // A pause keeps the dump (its files, counters and recorded intervals) and
+  // only leaves out what arrives meanwhile; the content side then starts a
+  // new part when the stream goes on.
+  _setPaused(session, value) {
+    try {
+      if (!session.browsingContext.isDiscarded) {
+        session.browsingContext.termuxMediaRecordingPaused = value;
+      }
+    } catch (e) {
+      console.error("TermuxMediaRecording: cannot set the pause flag", e);
+    }
+  },
+
+  _refreshMeta(session) {
+    try {
+      const wgp = session.browsingContext.currentWindowGlobal;
+      if (wgp) {
+        session.title = wgp.documentTitle || session.title;
+        session.url = wgp.documentURI?.spec || session.url;
+        try {
+          session.origin = wgp.documentURI?.host || session.origin;
+        } catch (e) {
+          // about:, blob: and friends have no host.
+        }
+      }
+    } catch (e) {
+      // Discarded context; keep what we had.
+    }
+    if (!session.title) {
+      for (const track of session.tracks.values()) {
+        if (track.title) {
+          session.title = track.title;
+          session.url = session.url || track.url || "";
+          break;
+        }
+      }
+    }
+  },
+
+  _stateOf(session) {
+    if (session.restored) {
+      return {
+        ...session.restored,
+        browsingContext: null,
+        browsingContextId: session.browsingContextId,
+        status: session.status,
+        endedByPage: session.endedByPage,
+        dir: session.dir,
+        error: session.mergeError,
+        progress: session.progress,
+        stage: session.stage,
+        mergeStartedAt: session.mergeStartedAt,
+        output: session.output,
+        outputBytes: session.outputBytes,
+        summaryPath: session.summaryPath,
+      };
+    }
+    const tracks = [];
+    let bytes = 0;
+    let parts = 0;
+    const capturedUsByKind = new Map();
+    let encrypted = false;
+    let noDir = false;
+    let writeError = false;
+    const files = [];
+    const source = session.frozenTracks || session.tracks;
+    for (const t of source.values()) {
+      const trackFileList = trackFiles(t);
+      files.push(...trackFileList);
+      bytes += t.bytes || 0;
+      parts += t.parts || 0;
+      // The media time written (the recorded intervals' total), not the
+      // span between the first and the last timestamp. The buffers of one
+      // kind add up (a page that replaces its player continues the program
+      // in a new buffer); video and audio run in parallel.
+      capturedUsByKind.set(
+        t.kind,
+        (capturedUsByKind.get(t.kind) || 0) + (t.recordedUs || 0)
+      );
+      encrypted = encrypted || !!t.encrypted;
+      noDir = noDir || !!t.noDir;
+      writeError = writeError || !!t.writeError;
+      tracks.push({
+        id: t.key,
+        kind: t.kind,
+        mime: t.mime,
+        codec: t.codec,
+        width: t.width,
+        height: t.height,
+        rate: t.rate,
+        channels: t.channels,
+        encrypted: !!t.encrypted,
+        state: t.state,
+        bytes: t.bytes || 0,
+        parts: t.parts || 0,
+        startUs: t.startUs,
+        endUs: t.endUs,
+        recordedUs: t.recordedUs || 0,
+        // Dump decisions, for diagnosis: segments left out as already
+        // recorded, dropped while waiting for a keyframe to start a part,
+        // and dropped for a zero-size sample.
+        skippedSegments: t.skippedSegments || 0,
+        keyframeWaits: t.keyframeWaits || 0,
+        emptySegments: t.emptySegments || 0,
+        files: trackFileList,
+      });
+    }
+    let error = session.mergeError;
+    if (noDir) {
+      error = `${PREF_DIR} is not set`;
+    } else if (writeError) {
+      error = "could not write to the recording directory";
+    }
+    return {
+      browsingContext: session.browsingContext,
+      browsingContextId: session.browsingContextId,
+      status: session.status,
+      title: session.title,
+      url: session.url,
+      origin: session.origin,
+      startedAt: session.startedAt,
+      stoppedAt: session.stoppedAt,
+      endedByPage: session.endedByPage,
+      dir: session.dir,
+      encrypted,
+      error,
+      bytes,
+      parts,
+      capturedMs: Math.round(Math.max(0, ...capturedUsByKind.values()) / 1000),
+      tracks,
+      files,
+      progress: session.progress,
+      stage: session.stage,
+      mergeStartedAt: session.mergeStartedAt,
+      output: session.output,
+      outputBytes: session.outputBytes,
+      summaryPath: session.summaryPath,
+    };
+  },
+
+  _prefixOf(session) {
+    if (session.prefix) {
+      return session.prefix;
+    }
+    if (session.folder) {
+      // <folder>/<folder>.mp4 and .json: the name survives a copy elsewhere.
+      return session.folder;
+    }
+    const source = session.frozenTracks || session.tracks;
+    for (const t of source.values()) {
+      if (t.base) {
+        return t.base.replace(/-(video|audio)-\d+$/, "");
+      }
+    }
+    return `recording-${session.startedAt || Date.now()}`;
+  },
+
+  async _writeSummary(session, summary) {
+    if (!session.dir) {
+      return;
+    }
+    const path = `${session.dir}/${this._prefixOf(session)}.json`;
+    const { browsingContext, ...plain } = summary;
+    try {
+      await IOUtils.writeJSON(path, plain);
+      session.summaryPath = path;
+    } catch (e) {
+      console.error("TermuxMediaRecording: cannot write the summary", e);
+    }
+  },
+
+  /**
+   * Merge: the parts of all tracks of a kind go in media order (planParts),
+   * parts of another size than the main rendition are rescaled to it (H.264
+   * only), the result is concatenated (stream copy, overlaps trimmed), and
+   * video and audio are muxed into <dir>/<prefix>.mp4 (or .webm). Progress
+   * comes from ffmpeg's -progress output.
+   */
+  async _merge(session) {
+    const state = this._stateOf(session);
+    const webm = state.files.some(f => f.endsWith(".webm"));
+    if (!state.files.length) {
+      this._finishMerge(session, { error: "nothing was captured" });
+      return;
+    }
+
+    const ffmpeg = await this._ffmpegPath();
+    if (!ffmpeg) {
+      this._finishMerge(session, {
+        error: "ffmpeg was not found (pkg install ffmpeg); the parts are kept",
+      });
+      return;
+    }
+
+    // 1. Measure every part: where it starts in the stream's timeline and
+    //    its picture size (ffprobe), and how much media it really holds (a
+    //    stream-copy pass to the null muxer). The header cannot be trusted
+    //    for the length: a live stream's init segment may claim hours. A part
+    //    ffmpeg cannot read (or one without media) would fail the whole
+    //    concat: it is left out and kept on disk.
+    const byKind = new Map();
+    const startUsByKind = new Map();
+    const unreadable = [];
+    let order = 0;
+    const fileCount = state.tracks.reduce((n, t) => n + t.files.length, 0);
+    let measured = 0;
+    for (const track of state.tracks) {
+      if (track.startUs >= 0) {
+        startUsByKind.set(
+          track.kind,
+          Math.min(startUsByKind.get(track.kind) ?? Infinity, track.startUs)
+        );
+      }
+      for (const file of track.files) {
+        session.stage = { name: "measuring", index: ++measured, count: fileCount };
+        session.progress = (MEASURE_SHARE * (measured - 1)) / fileCount;
+        this._emit("state-changed", session);
+        if (!(await IOUtils.exists(file))) {
+          console.warn(`TermuxMediaRecording: ${file} is missing`);
+          continue;
+        }
+        const span = await this._measureSpan(ffmpeg, file);
+        if (!span) {
+          console.warn(`TermuxMediaRecording: ${file} has no readable media`);
+          unreadable.push(file);
+          continue;
+        }
+        const info = await this._probeInfo(ffmpeg, file);
+        if (!byKind.has(track.kind)) {
+          byKind.set(track.kind, []);
+        }
+        byKind.get(track.kind).push({
+          file,
+          span,
+          order: order++,
+          start: info.start,
+          // The timeline of the file in the concat list (a rescaled copy
+          // starts over at zero while `start` stays the stream's time).
+          fileStart: info.start,
+          width: info.width,
+          height: info.height,
+          codec: info.codec,
+          profile: info.profile,
+          timescale: info.timescale,
+        });
+      }
+    }
+    if (!byKind.size) {
+      this._finishMerge(session, { error: "nothing was captured" });
+      return;
+    }
+
+    const prefix = `${session.dir}/${this._prefixOf(session)}`;
+    const outExt = webm ? "webm" : "mp4";
+    const output = `${prefix}.${outExt}`;
+    const temporaries = [];
+    const plans = new Map();
+    for (const [kind, parts] of byKind) {
+      plans.set(kind, planParts(parts));
+    }
+    const rescale =
+      !webm && Services.prefs.getBoolPref(PREF_RESCALE, true);
+    // The rest of the bar is shared by the steps in proportion to their
+    // expected run time: a re-encode runs about as fast as the media plays,
+    // a stream copy many times faster.
+    const rescaleParts = rescale ? plans.get("video")?.rescale || [] : [];
+    const joinKinds = [...plans].filter(([, plan]) => plan.parts.length > 1);
+    const copyWork = parts =>
+      COPY_COST * parts.reduce((sum, part) => sum + part.span, 0) + 1;
+    const muxWork = COPY_COST * (state.capturedMs / 1000) + 1;
+    const totalWork =
+      rescaleParts.reduce((sum, part) => sum + part.span + 1, 0) +
+      joinKinds.reduce((sum, [, plan]) => sum + copyWork(plan.parts), 0) +
+      muxWork;
+    let doneWork = 0;
+    let stepWork = 0;
+    const report = fraction => {
+      const share = (doneWork + fraction * stepWork) / totalWork;
+      session.progress = Math.min(
+        0.99,
+        Math.max(session.progress, MEASURE_SHARE + (1 - MEASURE_SHARE) * share)
+      );
+      this._emit("state-changed", session);
+    };
+    const begin = (name, index, count, work, kind = undefined) => {
+      session.stage = { name, index, count, kind };
+      stepWork = work;
+      report(0);
+    };
+    const end = () => {
+      doneWork += stepWork;
+      stepWork = 0;
+    };
+
+    // 2. Rescale the parts of another size to the main rendition, so that
+    //    the picture size never changes inside the file (players that do not
+    //    reconfigure their decoder on an in-band change show the small
+    //    picture inside the big one). Only the odd parts are re-encoded; a
+    //    part whose encode fails stays as it is.
+    if (rescale) {
+      const plan = plans.get("video");
+      for (const [i, part] of rescaleParts.entries()) {
+        begin("rescaling", i + 1, rescaleParts.length, part.span + 1);
+        const target = `${prefix}-video-${String(part.order).padStart(3, "0")}.rescaled.mp4`;
+        temporaries.push(target);
+        try {
+          await this._rescalePart(ffmpeg, part, plan.main, target, report);
+          const span = await this._measureSpan(ffmpeg, target);
+          if (!span) {
+            throw new Error("the rescaled part has no readable media");
+          }
+          part.file = target;
+          part.span = Math.min(part.span, span);
+          part.fileStart = (await this._probeInfo(ffmpeg, target)).start ?? 0;
+        } catch (e) {
+          console.warn(`TermuxMediaRecording: cannot rescale ${part.file}`, e);
+        }
+        end();
+      }
+    }
+
+    // 3. One file per kind. Each part is placed right after the previous
+    //    one and cut at its measured end (an audio tail past the last video
+    //    frame would overlap the next part), or where the next part starts
+    //    inside it. outpoint is in the file's own timeline.
+    const inputs = [];
+    for (const [kind, plan] of plans) {
+      const parts = plan.parts;
+      if (!parts.length) {
+        continue;
+      }
+      let start = parts[0].start;
+      if (start === null && startUsByKind.has(kind)) {
+        start = startUsByKind.get(kind) / 1e6;
+      }
+      if (parts.length === 1) {
+        inputs.push({ path: parts[0].file, kind, start });
+        continue;
+      }
+      const list = `${prefix}-${kind}.concat.txt`;
+      const merged = `${prefix}-${kind}.merged.${outExt}`;
+      temporaries.push(list, merged);
+      const lines = [];
+      let totalMs = 0;
+      parts.forEach((part, i) => {
+        lines.push(`file '${part.file.replace(/'/g, "'\\''")}'`);
+        let span = part.span;
+        const next = parts[i + 1];
+        if (
+          next &&
+          part.start !== null &&
+          next.start !== null &&
+          next.start > part.start &&
+          next.start < part.start + span
+        ) {
+          span = next.start - part.start;
+        }
