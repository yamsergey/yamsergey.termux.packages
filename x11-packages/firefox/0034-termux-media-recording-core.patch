+// False when the first video sample of an fMP4 media segment is not a
+// keyframe (trun first_sample_flags or sample_flags, else the tfhd and trex
+// defaults). A segment without video samples passes.
+bool Mp4SegmentStartsWithKeyframe(
+    const uint8_t* aData, size_t aLength,
+    const nsTArray<TrackBuffersManager::DumpTrack>& aTracks) {
+  bool decided = false;
+  bool keyframe = true;
+  ForEachBox(aData, 0, aLength, [&](uint32_t aType, size_t aStart,
+                                    size_t aEnd) {
+    if (decided || aType != Fourcc("moof")) {
+      return;
+    }
+    ForEachBox(aData, aStart, aEnd, [&](uint32_t aType, size_t aStart,
+                                        size_t aEnd) {
+      if (decided || aType != Fourcc("traf")) {
+        return;
+      }
+      const TrackBuffersManager::DumpTrack* track = nullptr;
+      bool haveFlags = false;
+      uint32_t flags = 0;
+      uint32_t samples = 0;
+      bool firstTrun = true;
+      ForEachBox(aData, aStart, aEnd, [&](uint32_t aType, size_t aStart,
+                                          size_t aEnd) {
+        if (aType == Fourcc("tfhd") && aStart + 8 <= aEnd) {
+          uint32_t tfFlags = ReadU32(aData, aStart) & 0xffffff;
+          uint32_t id = ReadU32(aData, aStart + 4);
+          for (const auto& t : aTracks) {
+            if (t.mId == id) {
+              track = &t;
+            }
+          }
+          size_t pos = aStart + 8;
+          if (tfFlags & 0x1) pos += 8;   // base_data_offset
+          if (tfFlags & 0x2) pos += 4;   // sample_description_index
+          if (tfFlags & 0x8) pos += 4;   // default_sample_duration
+          if (tfFlags & 0x10) pos += 4;  // default_sample_size
+          if ((tfFlags & 0x20) && pos + 4 <= aEnd) {
+            haveFlags = true;
+            flags = ReadU32(aData, pos);
+          }
+        } else if (aType == Fourcc("trun") && aStart + 8 <= aEnd) {
+          uint32_t trFlags = ReadU32(aData, aStart) & 0xffffff;
+          uint32_t count = ReadU32(aData, aStart + 4);
+          samples += count;
+          if (!firstTrun || !count) {
+            return;
+          }
+          firstTrun = false;
+          size_t pos = aStart + 8;
+          if (trFlags & 0x1) pos += 4;  // data_offset
+          if (trFlags & 0x4) {
+            if (pos + 4 <= aEnd) {
+              haveFlags = true;
+              flags = ReadU32(aData, pos);
+            }
+          } else if (trFlags & 0x400) {
+            pos += (trFlags & 0x100 ? 4 : 0) + (trFlags & 0x200 ? 4 : 0);
+            if (pos + 4 <= aEnd) {
+              haveFlags = true;
+              flags = ReadU32(aData, pos);
+            }
+          }
+        }
+      });
+      if (!track || !track->mVideo || !samples) {
+        return;
+      }
+      if (!haveFlags) {
+        flags = track->mDefaultFlags;
+      }
+      keyframe = !(flags & kSampleNotKeyframe);
+      decided = true;
+    });
+  });
+  return keyframe;
+}
+
+// True when an fMP4 media segment lists a sample of zero bytes (a frame a
+// live encoder dropped). Firefox plays past those, but ffmpeg's demuxer
+// refuses the whole file, so such a segment is left out of the dump.
+bool SegmentHasEmptySample(const uint8_t* aData, size_t aLength) {
+  bool empty = false;
+  ForEachBox(aData, 0, aLength, [&](uint32_t aType, size_t aStart,
+                                    size_t aEnd) {
+    if (aType != Fourcc("moof")) {
+      return;
+    }
+    ForEachBox(aData, aStart, aEnd, [&](uint32_t aType, size_t aStart,
+                                        size_t aEnd) {
+      if (aType != Fourcc("traf")) {
+        return;
+      }
+      bool hasDefaultSize = false;
+      uint32_t defaultSize = 0;
+      ForEachBox(aData, aStart, aEnd, [&](uint32_t aType, size_t aStart,
+                                          size_t aEnd) {
+        if (aType == Fourcc("tfhd") && aStart + 8 <= aEnd) {
+          uint32_t flags = ReadU32(aData, aStart) & 0xffffff;
+          size_t pos = aStart + 8;
+          if (flags & 0x1) pos += 8;  // base_data_offset
+          if (flags & 0x2) pos += 4;  // sample_description_index
+          if (flags & 0x8) pos += 4;  // default_sample_duration
+          if ((flags & 0x10) && pos + 4 <= aEnd) {
+            hasDefaultSize = true;
+            defaultSize = ReadU32(aData, pos);
+          }
+        } else if (aType == Fourcc("trun") && aStart + 8 <= aEnd) {
+          uint32_t flags = ReadU32(aData, aStart) & 0xffffff;
+          uint32_t count = ReadU32(aData, aStart + 4);
+          size_t pos = aStart + 8;
+          if (flags & 0x1) pos += 4;  // data_offset
+          if (flags & 0x4) pos += 4;  // first_sample_flags
+          size_t perSample = (flags & 0x100 ? 4 : 0) + (flags & 0x200 ? 4 : 0) +
+                             (flags & 0x400 ? 4 : 0) + (flags & 0x800 ? 4 : 0);
+          if (!(flags & 0x200)) {
+            empty = empty || (hasDefaultSize && defaultSize == 0 && count);
+            return;
+          }
+          size_t sizeAt = pos + (flags & 0x100 ? 4 : 0);
+          for (uint32_t i = 0; i < count && sizeAt + 4 <= aEnd; i++) {
+            if (ReadU32(aData, sizeAt) == 0) {
+              empty = true;
+              return;
+            }
+            sizeAt += perSample;
+          }
+        }
+      });
+    });
+  });
+  return empty;
+}
+
+// EBML (WebM). An element id keeps its length marker; a size does not, and
+// all ones means "unknown" (live clusters, the segment itself).
+bool ReadEbmlId(const uint8_t* aData, size_t aPos, size_t aEnd, uint32_t& aId,
+                size_t& aLength) {
+  if (aPos >= aEnd || !aData[aPos]) {
+    return false;
+  }
+  size_t length = 1;
+  for (uint8_t mask = 0x80; !(aData[aPos] & mask); mask >>= 1) {
+    length++;
+  }
+  if (length > 4 || aPos + length > aEnd) {
+    return false;
+  }
+  aId = 0;
+  for (size_t i = 0; i < length; i++) {
+    aId = (aId << 8) | aData[aPos + i];
+  }
+  aLength = length;
+  return true;
+}
+
+bool ReadEbmlSize(const uint8_t* aData, size_t aPos, size_t aEnd,
+                  uint64_t& aValue, size_t& aLength, bool& aUnknown) {
+  if (aPos >= aEnd || !aData[aPos]) {
+    return false;
+  }
+  size_t length = 1;
+  uint8_t mask = 0x80;
+  for (; !(aData[aPos] & mask); mask >>= 1) {
+    length++;
+  }
+  if (length > 8 || aPos + length > aEnd) {
+    return false;
+  }
+  aValue = aData[aPos] & uint8_t(mask - 1);
+  aUnknown = aValue == uint64_t(mask - 1);
+  for (size_t i = 1; i < length; i++) {
+    aValue = (aValue << 8) | aData[aPos + i];
+    aUnknown = aUnknown && aData[aPos + i] == 0xff;
+  }
+  aLength = length;
+  return true;
+}
+
+uint64_t ReadEbmlUint(const uint8_t* aData, size_t aStart, size_t aEnd) {
+  uint64_t value = 0;
+  for (size_t i = aStart; i < aEnd && i < aStart + 8; i++) {
+    value = (value << 8) | aData[i];
+  }
+  return value;
+}
+
+// Calls aVisit(id, payloadStart, payloadEnd) for the elements in
+// [aPos, aEnd); one of unknown size runs to aEnd.
+template <typename F>
+void ForEachElement(const uint8_t* aData, size_t aPos, size_t aEnd,
+                    F&& aVisit) {
+  while (aPos < aEnd) {
+    uint32_t id;
+    size_t idLength;
+    uint64_t size;
+    size_t sizeLength;
+    bool unknown;
+    if (!ReadEbmlId(aData, aPos, aEnd, id, idLength) ||
+        !ReadEbmlSize(aData, aPos + idLength, aEnd, size, sizeLength,
+                      unknown)) {
+      return;
+    }
+    size_t payload = aPos + idLength + sizeLength;
+    size_t end = unknown || size > aEnd - payload ? aEnd : payload + size_t(size);
+    aVisit(id, payload, end);
+    aPos = end;
+  }
+}
+
+constexpr uint32_t kEbmlSegment = 0x18538067;
+constexpr uint32_t kEbmlInfo = 0x1549A966;
+constexpr uint32_t kEbmlTimecodeScale = 0x2AD7B1;
+constexpr uint32_t kEbmlTracks = 0x1654AE6B;
+constexpr uint32_t kEbmlTrackEntry = 0xAE;
+constexpr uint32_t kEbmlTrackNumber = 0xD7;
+constexpr uint32_t kEbmlTrackType = 0x83;
+constexpr uint32_t kEbmlDefaultDuration = 0x23E383;
+constexpr uint32_t kEbmlCluster = 0x1F43B675;
+constexpr uint32_t kEbmlTimecode = 0xE7;
+constexpr uint32_t kEbmlSimpleBlock = 0xA3;
+constexpr uint32_t kEbmlBlockGroup = 0xA0;
+constexpr uint32_t kEbmlBlock = 0xA1;
+constexpr uint32_t kEbmlBlockDuration = 0x9B;
+constexpr uint32_t kEbmlReferenceBlock = 0xFB;
+
+// The timecode scale and the tracks' default frame durations (both in ns)
+// of a WebM init segment.
+void ParseWebMInit(const uint8_t* aData, size_t aLength,
+                   nsTArray<TrackBuffersManager::DumpTrack>& aTracks,
+                   uint64_t& aTimecodeScaleNs) {
+  ForEachElement(aData, 0, aLength, [&](uint32_t aId, size_t aStart,
+                                        size_t aEnd) {
+    if (aId != kEbmlSegment) {
+      return;
+    }
+    ForEachElement(aData, aStart, aEnd, [&](uint32_t aId, size_t aStart,
+                                            size_t aEnd) {
+      if (aId == kEbmlInfo) {
+        ForEachElement(aData, aStart, aEnd, [&](uint32_t aId, size_t aStart,
+                                                size_t aEnd) {
+          if (aId == kEbmlTimecodeScale && aEnd > aStart) {
+            aTimecodeScaleNs = ReadEbmlUint(aData, aStart, aEnd);
+          }
+        });
+      } else if (aId == kEbmlTracks) {
+        ForEachElement(aData, aStart, aEnd, [&](uint32_t aId, size_t aStart,
+                                                size_t aEnd) {
+          if (aId != kEbmlTrackEntry) {
+            return;
+          }
+          TrackBuffersManager::DumpTrack track;
+          ForEachElement(aData, aStart, aEnd, [&](uint32_t aId, size_t aStart,
+                                                  size_t aEnd) {
+            if (aId == kEbmlTrackNumber) {
+              track.mId = ReadEbmlUint(aData, aStart, aEnd);
+            } else if (aId == kEbmlTrackType) {
+              track.mVideo = ReadEbmlUint(aData, aStart, aEnd) == 1;
+            } else if (aId == kEbmlDefaultDuration) {
+              track.mDefaultDuration = ReadEbmlUint(aData, aStart, aEnd);
+            }
+          });
+          if (track.mId) {
+            aTracks.AppendElement(track);
+          }
+        });
+      }
+    });
+  });
+  if (!aTimecodeScaleNs) {
+    aTimecodeScaleNs = 1000000;
+  }
+}
+
+struct WebMRange {
+  int64_t mStartNs = INT64_MAX;
+  int64_t mEndNs = INT64_MIN;
+  int64_t mLastStartNs = INT64_MIN;
+  int64_t mLastStep = 0;
+  bool mFound = false;
+};
+
+// A (Simple)Block: track number, a signed 16-bit timecode relative to the
+// cluster, flags, then the frame(s).
+void NoteWebMBlock(const uint8_t* aData, size_t aStart, size_t aEnd,
+                   int64_t aClusterTimecode, uint64_t aBlockDuration,
+                   const nsTArray<TrackBuffersManager::DumpTrack>& aTracks,
+                   uint64_t aScaleNs, WebMRange& aRange) {
+  uint64_t trackNumber;
+  size_t length;
+  bool unknown;
+  if (!ReadEbmlSize(aData, aStart, aEnd, trackNumber, length, unknown) ||
+      aStart + length + 3 > aEnd) {
+    return;
+  }
+  int16_t relative = int16_t(uint16_t(aData[aStart + length]) << 8 |
+                             aData[aStart + length + 1]);
+  int64_t startNs = (aClusterTimecode + relative) * int64_t(aScaleNs);
+  uint64_t durationNs = aBlockDuration * aScaleNs;
+  if (!durationNs) {
+    for (const auto& track : aTracks) {
+      if (track.mId == trackNumber) {
+        durationNs = track.mDefaultDuration;
+      }
+    }
+  }
+  if (aRange.mLastStartNs != INT64_MIN && startNs > aRange.mLastStartNs) {
+    aRange.mLastStep = startNs - aRange.mLastStartNs;
+  }
+  aRange.mLastStartNs = startNs;
+  aRange.mStartNs = std::min(aRange.mStartNs, startNs);
+  aRange.mEndNs = std::max(aRange.mEndNs, startNs + int64_t(durationNs));
+  aRange.mFound = true;
+}
+
+void ParseWebMCluster(const uint8_t* aData, size_t aStart, size_t aEnd,
+                      const nsTArray<TrackBuffersManager::DumpTrack>& aTracks,
+                      uint64_t aScaleNs, WebMRange& aRange) {
+  int64_t timecode = 0;
+  ForEachElement(aData, aStart, aEnd, [&](uint32_t aId, size_t aStart,
+                                          size_t aEnd) {
+    if (aId == kEbmlTimecode) {
+      timecode = int64_t(ReadEbmlUint(aData, aStart, aEnd));
+    } else if (aId == kEbmlSimpleBlock) {
+      NoteWebMBlock(aData, aStart, aEnd, timecode, 0, aTracks, aScaleNs,
+                    aRange);
+    } else if (aId == kEbmlBlockGroup) {
+      size_t blockStart = 0;
+      size_t blockEnd = 0;
+      uint64_t duration = 0;
+      ForEachElement(aData, aStart, aEnd, [&](uint32_t aId, size_t aStart,
+                                              size_t aEnd) {
+        if (aId == kEbmlBlock) {
+          blockStart = aStart;
+          blockEnd = aEnd;
+        } else if (aId == kEbmlBlockDuration) {
+          duration = ReadEbmlUint(aData, aStart, aEnd);
+        }
+      });
+      if (blockEnd > blockStart) {
+        NoteWebMBlock(aData, blockStart, blockEnd, timecode, duration, aTracks,
+                      aScaleNs, aRange);
+      }
+    } else if (aId == kEbmlCluster) {
+      // A cluster of unknown size swallows the next one: parse it on its own.
+      ParseWebMCluster(aData, aStart, aEnd, aTracks, aScaleNs, aRange);
+    }
+  });
+}
+
+// The time range covered by the clusters of a WebM media segment. Without a
+// block duration (no BlockGroup, no DefaultDuration) the last frame is given
+// the spacing of the ones before it.
+bool WebMSegmentRange(const uint8_t* aData, size_t aLength,
+                      const nsTArray<TrackBuffersManager::DumpTrack>& aTracks,
+                      uint64_t aScaleNs, int64_t& aStartUs, int64_t& aEndUs) {
+  WebMRange range;
+  auto visit = [&](uint32_t aId, size_t aStart, size_t aEnd) {
+    if (aId == kEbmlCluster) {
+      ParseWebMCluster(aData, aStart, aEnd, aTracks, aScaleNs, range);
+    }
+  };
+  ForEachElement(aData, 0, aLength, [&](uint32_t aId, size_t aStart,
+                                        size_t aEnd) {
+    // Media segments start with clusters; a whole file has them in the
+    // segment element.
+    if (aId == kEbmlSegment) {
+      ForEachElement(aData, aStart, aEnd, visit);
+    } else {
+      visit(aId, aStart, aEnd);
+    }
+  });
+  if (!range.mFound) {
+    return false;
+  }
+  if (range.mEndNs <= range.mLastStartNs && range.mLastStep > 0) {
+    range.mEndNs = range.mLastStartNs + range.mLastStep;
+  }
+  if (range.mEndNs <= range.mStartNs) {
+    return false;
+  }
+  aStartUs = range.mStartNs / 1000;
+  aEndUs = range.mEndNs / 1000;
+  return true;
+}
+
+// Looks for the first video block of a cluster: a SimpleBlock carries a
+// keyframe flag, a BlockGroup is a keyframe when it has no ReferenceBlock.
+void WebMClusterKeyframe(const uint8_t* aData, size_t aStart, size_t aEnd,
+                         const nsTArray<TrackBuffersManager::DumpTrack>& aTracks,
+                         bool& aDecided, bool& aKeyframe) {
+  ForEachElement(aData, aStart, aEnd, [&](uint32_t aId, size_t aStart,
+                                          size_t aEnd) {
+    if (aDecided) {
+      return;
+    }
+    uint64_t trackNumber;
+    size_t length;
+    bool unknown;
+    if (aId == kEbmlSimpleBlock) {
+      if (!ReadEbmlSize(aData, aStart, aEnd, trackNumber, length, unknown) ||
+          aStart + length + 3 > aEnd || !TrackIsVideo(aTracks, trackNumber)) {
+        return;
+      }
+      aKeyframe = aData[aStart + length + 2] & 0x80;
+      aDecided = true;
+    } else if (aId == kEbmlBlockGroup) {
+      bool video = false;
+      bool reference = false;
+      ForEachElement(aData, aStart, aEnd, [&](uint32_t aId, size_t aStart,
+                                              size_t aEnd) {
+        if (aId == kEbmlBlock) {
+          video = ReadEbmlSize(aData, aStart, aEnd, trackNumber, length,
+                               unknown) &&
+                  TrackIsVideo(aTracks, trackNumber);
+        } else if (aId == kEbmlReferenceBlock) {
+          reference = true;
+        }
+      });
+      if (video) {
+        aKeyframe = !reference;
+        aDecided = true;
+      }
+    } else if (aId == kEbmlCluster) {
+      WebMClusterKeyframe(aData, aStart, aEnd, aTracks, aDecided, aKeyframe);
+    }
+  });
+}
+
+// False when the first video block of a WebM media segment is not a
+// keyframe. A segment without video blocks passes.
+bool WebMSegmentStartsWithKeyframe(
+    const uint8_t* aData, size_t aLength,
+    const nsTArray<TrackBuffersManager::DumpTrack>& aTracks) {
+  bool decided = false;
+  bool keyframe = true;
+  auto visit = [&](uint32_t aId, size_t aStart, size_t aEnd) {
+    if (!decided && aId == kEbmlCluster) {
+      WebMClusterKeyframe(aData, aStart, aEnd, aTracks, decided, keyframe);
+    }
+  };
+  ForEachElement(aData, 0, aLength, [&](uint32_t aId, size_t aStart,
+                                        size_t aEnd) {
+    if (aId == kEbmlSegment) {
+      ForEachElement(aData, aStart, aEnd, visit);
+    } else {
+      visit(aId, aStart, aEnd);
+    }
+  });
+  return keyframe;
+}
