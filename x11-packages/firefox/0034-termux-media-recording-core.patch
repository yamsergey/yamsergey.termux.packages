+// Termux patch 0034: media recording.
+
+static void AppendJSONString(nsACString& aOut, const nsACString& aIn) {
+  aOut.Append('"');
+  for (uint32_t i = 0; i < aIn.Length(); i++) {
+    char c = aIn.CharAt(i);
+    switch (c) {
+      case '"':
+        aOut.AppendLiteral("\\\"");
+        break;
+      case '\\':
+        aOut.AppendLiteral("\\\\");
+        break;
+      case '\n':
+      case '\r':
+      case '\t':
+        aOut.Append(' ');
+        break;
+      default:
+        if (static_cast<unsigned char>(c) < 0x20) {
+          break;
+        }
+        aOut.Append(c);
+    }
+  }
+  aOut.Append('"');
+}
+
+void SourceBuffer::UpdateDumpState() {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!mMediaSource || !mTrackBuffersManager) {
+    return;
+  }
+  nsPIDOMWindowInner* window = mMediaSource->GetOwnerWindow();
+  Document* doc = window ? window->GetExtantDoc() : nullptr;
+  BrowsingContext* bc = doc ? doc->GetBrowsingContext() : nullptr;
+  bool want = bc && bc->Top() && bc->Top()->TermuxMediaRecording();
+  if (want == mDumpRequested) {
+    return;
+  }
+  mDumpRequested = want;
+  mDumpNoDir = false;
+  if (!want) {
+    mTrackBuffersManager->SetDump(false, ""_ns, ""_ns, ""_ns);
+    ReportDumpState(nullptr, true);
+    return;
+  }
+
+  nsAutoCString dir;
+  Preferences::GetCString("media.termux.recording.dir", dir);
+  if (dir.IsEmpty()) {
+    MSE_DEBUG("Dump requested but media.termux.recording.dir is empty");
+    mDumpNoDir = true;
+    ReportDumpState(nullptr, true);
+    return;
+  }
+  dir.Trim("/", false, true);
+
+  // <unix time>-<host>-<video|audio>-<id>, part and extension added by the
+  // TrackBuffersManager.
+  nsAutoCString host;
+  if (doc->NodePrincipal()) {
+    doc->NodePrincipal()->GetAsciiHost(host);
+  }
+  if (host.IsEmpty()) {
+    host.AssignLiteral("page");
+  }
+  for (size_t i = 0; i < host.Length(); i++) {
+    char c = host.CharAt(i);
+    bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+              (c >= '0' && c <= '9') || c == '.' || c == '-';
+    if (!ok) {
+      host.SetCharAt('_', i);
+    }
+  }
+  const char* kind =
+      mType.ExtendedType().Type().HasAudioMajorType() ? "audio" : "video";
+  mDumpDir = dir;
+  mDumpBaseName = nsPrintfCString("%lld-%s-%s-%u", (long long)time(nullptr),
+                                  host.get(), kind, mDumpId);
+  mDumpExt = StringEndsWith(mType.Type().AsString(), "/webm"_ns) ? "webm"_ns
+                                                                  : "mp4"_ns;
+  mTrackBuffersManager->SetDump(true, mDumpDir, mDumpBaseName, mDumpExt);
+  ReportDumpState(nullptr, true);
+}
+
+void SourceBuffer::ReportDumpState(const char* aState, bool aForce) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!mMediaSource || !mTrackBuffersManager) {
+    return;
+  }
+  nsPIDOMWindowInner* window = mMediaSource->GetOwnerWindow();
+  if (!window) {
+    return;
+  }
+  if (!mDumpId) {
+    static uint32_t sNextDumpId = 0;
+    mDumpId = ++sNextDumpId;
+  }
+
+  TrackBuffersManager::DumpStats stats = mTrackBuffersManager->GetDumpStats();
+  nsAutoCString state;
+  if (aState) {
+    state.Assign(aState);
+  } else if (mDumpNoDir || stats.mError) {
+    state.AssignLiteral("error");
+  } else if (mDumpRequested) {
+    state.AssignLiteral("recording");
+  } else {
+    state.AssignLiteral("idle");
+  }
+
+  TimeStamp now = TimeStamp::Now();
+  if (!aForce && state == mDumpLastState && !mDumpLastReport.IsNull()) {
+    bool quiet = stats.mBytes == mDumpLastBytes;
+    double since = (now - mDumpLastReport).ToMilliseconds();
+    // Idle streams every 5 s (keeps the stream known to chrome), recordings
+    // once a second.
+    if (since < (quiet ? 5000.0 : 1000.0)) {
+      return;
+    }
+  }
+  mDumpLastReport = now;
+  mDumpLastBytes = stats.mBytes;
+  mDumpLastState = state;
+
+  MediaInfo info = mTrackBuffersManager->GetMetadata();
+  const char* kind =
+      mType.ExtendedType().Type().HasAudioMajorType() ? "audio" : "video";
+  nsAutoCString codec;
+  if (info.HasVideo()) {
+    codec = info.mVideo.mMimeType;
+  } else if (info.HasAudio()) {
+    codec = info.mAudio.mMimeType;
+  }
+
+  nsAutoCString json;
+  json.AppendLiteral("{\"id\":");
+  json.AppendInt(mDumpId);
+  json.AppendLiteral(",\"state\":");
+  AppendJSONString(json, state);
+  json.AppendLiteral(",\"kind\":\"");
+  json.Append(kind);
+  json.AppendLiteral("\",\"mime\":");
+  AppendJSONString(json, mType.OriginalString());
+  json.AppendLiteral(",\"encrypted\":");
+  json.Append(info.IsEncrypted() ? "true" : "false");
+  json.AppendLiteral(",\"width\":");
+  json.AppendInt(info.HasVideo() ? info.mVideo.mDisplay.width : 0);
+  json.AppendLiteral(",\"height\":");
+  json.AppendInt(info.HasVideo() ? info.mVideo.mDisplay.height : 0);
+  json.AppendLiteral(",\"rate\":");
+  json.AppendInt(info.HasAudio() ? info.mAudio.mRate : 0u);
+  json.AppendLiteral(",\"channels\":");
+  json.AppendInt(info.HasAudio() ? info.mAudio.mChannels : 0u);
+  json.AppendLiteral(",\"codec\":");
+  AppendJSONString(json, codec);
+  json.AppendLiteral(",\"noDir\":");
+  json.Append(mDumpNoDir ? "true" : "false");
+  json.AppendLiteral(",\"writeError\":");
+  json.Append(stats.mError ? "true" : "false");
+  json.AppendLiteral(",\"bytes\":");
+  json.AppendInt(stats.mBytes);
+  json.AppendLiteral(",\"parts\":");
+  json.AppendInt(stats.mParts);
+  json.AppendLiteral(",\"startUs\":");
+  json.AppendInt(stats.mStartUs);
+  json.AppendLiteral(",\"endUs\":");
+  json.AppendInt(stats.mEndUs);
+  json.AppendLiteral(",\"dir\":");
+  AppendJSONString(json, mDumpDir);
+  json.AppendLiteral(",\"base\":");
+  AppendJSONString(json, mDumpBaseName);
+  json.AppendLiteral(",\"ext\":");
+  AppendJSONString(json, mDumpExt);
+  json.Append('}');
+
+  // Asynchronously: Detach() runs during media element teardown, at times
+  // when script is blocked, and the observer is a JSWindowActor.
+  nsCOMPtr<nsPIDOMWindowInner> win = window;
+  nsString data = NS_ConvertUTF8toUTF16(json);
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "SourceBuffer::ReportDumpState", [win, data]() {
+        nsCOMPtr<nsIObserverService> obs = services::GetObserverService();
+        if (!obs) {
+          return;
+        }
+        nsCOMPtr<nsISupports> subject = do_QueryInterface(win);
+        obs->NotifyObservers(subject, "termux-media-recording", data.get());
+      }));
+}
+
 void SourceBuffer::AppendDataErrored(const MediaResult& aError) {
   MOZ_ASSERT(mUpdating);
   mPendingAppend.Complete();
