+
+void TrackBuffersManager::SetDump(bool aEnabled, const nsACString& aDir,
+                                  const nsACString& aBaseName,
+                                  const nsACString& aExt) {
+  MOZ_ASSERT(NS_IsMainThread());
+  RefPtr<TaskQueue> taskQueue = GetTaskQueueSafe();
+  if (!taskQueue) {
+    return;
+  }
+  nsCString dir(aDir);
+  nsCString base(aBaseName);
+  nsCString ext(aExt);
+  Unused << taskQueue->Dispatch(NS_NewRunnableFunction(
+      "TrackBuffersManager::SetDump",
+      [self = RefPtr<TrackBuffersManager>(this), aEnabled, dir, base, ext]() {
+        self->DoSetDump(aEnabled, dir, base, ext);
+      }));
+}
+
+TrackBuffersManager::DumpStats TrackBuffersManager::GetDumpStats() const {
+  DumpStats stats;
+  stats.mEnabled = mDumpEnabled;
+  stats.mError = mDumpError;
+  stats.mBytes = mDumpBytes;
+  stats.mParts = mDumpParts;
+  stats.mStartUs = mDumpStartUs;
+  stats.mEndUs = mDumpEndUs;
+  return stats;
+}
+
+void TrackBuffersManager::DoSetDump(bool aEnabled, const nsCString& aDir,
+                                    const nsCString& aBaseName,
+                                    const nsCString& aExt) {
+  if (!aEnabled) {
+    DumpClose();
+    mDumpEnabled = false;
+    mDumpAwaitSegment = false;
+    mDumpNeedsRotate = false;
+    MSE_DEBUG("Dump off ({} bytes, {} parts)", uint64_t(mDumpBytes),
+              uint32_t(mDumpParts));
+    return;
+  }
+  if (mDumpEnabled) {
+    return;
+  }
+  mDumpDir = aDir;
+  mDumpBaseName = aBaseName;
+  mDumpExt = aExt;
+  mDumpBytes = 0;
+  mDumpParts = 0;
+  mDumpStartUs = -1;
+  mDumpEndUs = -1;
+  mDumpError = false;
+  // The current init segment is written, and media data copied, from the
+  // next segment boundary on (SegmentParserLoop).
+  mDumpNeedsRotate = true;
+  mDumpAwaitSegment = true;
+  mDumpEnabled = true;
+  MSE_DEBUG("Dump on: {}/{}-pNNN.{}", mDumpDir.get(), mDumpBaseName.get(),
+            mDumpExt.get());
+}
+
+void TrackBuffersManager::DumpWriteInit(MediaByteBuffer* aInit) {
+  if (!mDumpEnabled || !aInit || aInit->IsEmpty()) {
+    return;
+  }
+  mDumpNeedsRotate = true;
+  mDumpAwaitSegment = false;
+  DumpWriteBytes(aInit->Elements(), aInit->Length());
+}
+
+void TrackBuffersManager::DumpWriteMedia(const MediaSpan& aData) {
+  if (!mDumpEnabled || mDumpAwaitSegment) {
+    return;
+  }
+  DumpWriteBytes(aData.Elements(), aData.Length());
+}
+
+void TrackBuffersManager::DumpWriteBytes(const uint8_t* aData,
+                                         size_t aLength) {
+  if (!aLength) {
+    return;
+  }
+  if (mDumpNeedsRotate) {
+    DumpClose();
+    mDumpNeedsRotate = false;
+    uint32_t part = ++mDumpParts;
+    nsPrintfCString path("%s/%s-p%03u.%s", mDumpDir.get(),
+                         mDumpBaseName.get(), part, mDumpExt.get());
+    mDumpFile = fopen(path.get(), "wb");
+    if (!mDumpFile) {
+      MSE_DEBUG("Dump: cannot open {}", path.get());
+      mDumpError = true;
+      mDumpEnabled = false;
+      return;
+    }
+    MSE_DEBUG("Dump: part {} -> {}", part, path.get());
+  }
+  if (!mDumpFile) {
+    return;
+  }
+  size_t written = fwrite(aData, 1, aLength, mDumpFile);
+  // Keep the file complete on disk even while it stays open.
+  fflush(mDumpFile);
+  mDumpBytes += written;
+  if (written != aLength) {
+    MSE_DEBUG("Dump: short write ({} of {})", written, aLength);
+    mDumpError = true;
+  }
+}
+
+void TrackBuffersManager::DumpNoteSegment(const media::TimeUnit& aStart,
+                                          const media::TimeUnit& aEnd) {
+  if (!mDumpEnabled || mDumpAwaitSegment) {
+    return;
+  }
+  int64_t start = aStart.ToMicroseconds();
+  int64_t end = aEnd.ToMicroseconds();
+  if (mDumpStartUs < 0 || start < mDumpStartUs) {
+    mDumpStartUs = start;
+  }
+  if (end > mDumpEndUs) {
+    mDumpEndUs = end;
+  }
+}
+
+void TrackBuffersManager::DumpClose() {
+  if (mDumpFile) {
+    fclose(mDumpFile);
+    mDumpFile = nullptr;
+  }
+}
 
