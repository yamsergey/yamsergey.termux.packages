+TrackBuffersManager::DumpStats TrackBuffersManager::GetDumpStats() const {
+  DumpStats stats;
+  stats.mEnabled = mDumpEnabled;
+  stats.mError = mDumpError;
+  stats.mBytes = mDumpBytes;
+  stats.mParts = mDumpParts;
+  stats.mStartUs = mDumpStartUs;
+  stats.mEndUs = mDumpEndUs;
+  stats.mRecordedUs = mDumpRecordedUs;
+  stats.mSkippedSegments = mDumpSkippedSegments;
+  stats.mKeyframeWaits = mDumpKeyframeWaits;
+  stats.mEmptySegments = mDumpEmptySegments;
+  return stats;
+}
+
+void TrackBuffersManager::DoSetDump(bool aEnabled, const nsCString& aDir,
+                                    const nsCString& aBaseName,
+                                    const nsCString& aExt) {
+  if (!aEnabled) {
+    DumpClose();
+    DumpDropPending();
+    mDumpCurrentInit = nullptr;
+    mDumpTracks.Clear();
+    mDumpNeedPart = false;
+    mDumpEnabled = false;
+    mDumpAwaitSegment = false;
+    MSE_DEBUG("Dump off ({} bytes, {} parts)", uint64_t(mDumpBytes),
+              uint32_t(mDumpParts));
+    return;
+  }
+  if (mDumpEnabled) {
+    return;
+  }
+  mDumpDir = aDir;
+  mDumpBaseName = aBaseName;
+  mDumpExt = aExt;
+  mDumpBytes = 0;
+  mDumpParts = 0;
+  mDumpStartUs = -1;
+  mDumpEndUs = -1;
+  mDumpRecordedUs = 0;
+  mDumpSkippedSegments = 0;
+  mDumpKeyframeWaits = 0;
+  mDumpEmptySegments = 0;
+  mDumpError = false;
+  mDumpCurrentInit = nullptr;
+  mDumpTracks.Clear();
+  mDumpTimecodeScaleNs = 1000000;
+  mDumpNeedPart = false;
+  mDumpNotedStartUs = -1;
+  mDumpNotedEndUs = -1;
+  mDumpPartLastStartUs = -1;
+  mDumpPartLastEndUs = -1;
+  mDumpRecorded = media::TimeIntervals();
+  DumpDropPending();
+  // The current init segment is written, and media data copied, from the
+  // next segment boundary on (SegmentParserLoop).
+  mDumpAwaitSegment = true;
+  mDumpEnabled = true;
+  MSE_DEBUG("Dump on: {}/{}-pNNN.{}", mDumpDir.get(), mDumpBaseName.get(),
+            mDumpExt.get());
+}
