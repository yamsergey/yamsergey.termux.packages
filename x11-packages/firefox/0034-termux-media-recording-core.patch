+}  // namespace
+
+// ---- Termux patch 0034: the media dump --------------------------------------
+
+void TrackBuffersManager::DumpWriteInit(MediaByteBuffer* aInit) {
+  if (!mDumpEnabled || !aInit || aInit->IsEmpty()) {
+    return;
+  }
+  mDumpAwaitSegment = false;
+  // An init segment only arrives at a segment boundary; whatever was pending
+  // was cut short (abort, discontinuity) and would corrupt the part.
+  DumpDropPending();
+  mDumpNotedStartUs = -1;
+  mDumpNotedEndUs = -1;
+
+  // The same init segment again: the part keeps going.
+  if (mDumpCurrentInit && *mDumpCurrentInit == *aInit) {
+    return;
+  }
+  // A new rendition: its segments go to a new part, opened once the first
+  // one is written so that a rendition that sends no media leaves no file.
+  RefPtr<MediaByteBuffer> init = new MediaByteBuffer();
+  (void)init->AppendElements(aInit->Elements(), aInit->Length());
+  mDumpCurrentInit = init;
+  mDumpTracks.Clear();
+  mDumpTimecodeScaleNs = 1000000;
+  if (mDumpExt.EqualsLiteral("mp4")) {
+    ParseMp4Init(init->Elements(), init->Length(), mDumpTracks);
+  } else if (mDumpExt.EqualsLiteral("webm")) {
+    ParseWebMInit(init->Elements(), init->Length(), mDumpTracks,
+                  mDumpTimecodeScaleNs);
+  }
+  MSE_DEBUG("Dump: new init segment ({} bytes, {} tracks known)",
+            init->Length(), mDumpTracks.Length());
+  mDumpNeedPart = true;
+}
+
+bool TrackBuffersManager::DumpOpenPart() {
+  DumpClose();
+  mDumpPartLastStartUs = -1;
+  mDumpPartLastEndUs = -1;
+  mDumpNeedPart = false;
+  if (!mDumpCurrentInit) {
+    return false;
+  }
+  uint32_t part = ++mDumpParts;
+  nsPrintfCString path("%s/%s-p%03u.%s", mDumpDir.get(), mDumpBaseName.get(),
+                       part, mDumpExt.get());
+  mDumpFile = fopen(path.get(), "wb");
+  if (!mDumpFile) {
+    MSE_DEBUG("Dump: cannot open {}", path.get());
+    mDumpError = true;
+    mDumpEnabled = false;
+    return false;
+  }
+  MSE_DEBUG("Dump: part {} -> {}", part, path.get());
+  DumpWriteBytes(mDumpCurrentInit->Elements(), mDumpCurrentInit->Length());
+  return true;
+}
+
+void TrackBuffersManager::DumpWriteMedia(const MediaSpan& aData) {
+  if (!mDumpEnabled || mDumpAwaitSegment) {
+    return;
+  }
+  (void)mDumpPending.AppendElements(aData.Elements(), aData.Length());
+}
+
+void TrackBuffersManager::DumpNoteSegment(const media::TimeUnit& aStart,
+                                          const media::TimeUnit& aEnd) {
+  if (!mDumpEnabled || mDumpAwaitSegment || aEnd <= aStart) {
+    return;
+  }
+  // ContainerParser's range covers everything it was handed, which may be
+  // several segments; it is only a fallback for a segment that cannot be
+  // read in DumpFlushSegment.
+  mDumpNotedStartUs = aStart.ToMicroseconds();
+  mDumpNotedEndUs = aEnd.ToMicroseconds();
+}
+
+bool TrackBuffersManager::DumpSegmentRange(int64_t& aStartUs,
+                                           int64_t& aEndUs) const {
+  if (mDumpExt.EqualsLiteral("mp4")) {
+    return Mp4SegmentRange(mDumpPending.Elements(), mDumpPending.Length(),
+                           mDumpTracks, aStartUs, aEndUs);
+  }
+  if (mDumpExt.EqualsLiteral("webm")) {
+    return WebMSegmentRange(mDumpPending.Elements(), mDumpPending.Length(),
+                            mDumpTracks, mDumpTimecodeScaleNs, aStartUs,
+                            aEndUs);
+  }
+  return false;
+}
+
+bool TrackBuffersManager::DumpSegmentStartsWithKeyframe() const {
+  if (mDumpExt.EqualsLiteral("mp4")) {
+    return Mp4SegmentStartsWithKeyframe(mDumpPending.Elements(),
+                                        mDumpPending.Length(), mDumpTracks);
+  }
+  if (mDumpExt.EqualsLiteral("webm")) {
+    return WebMSegmentStartsWithKeyframe(mDumpPending.Elements(),
+                                         mDumpPending.Length(), mDumpTracks);
+  }
+  return true;
+}
+
+void TrackBuffersManager::DumpFlushSegment() {
+  if (!mDumpEnabled || mDumpPending.IsEmpty()) {
+    return;
+  }
+  int64_t start = mDumpNotedStartUs;
+  int64_t end = mDumpNotedEndUs;
+  mDumpNotedStartUs = -1;
+  mDumpNotedEndUs = -1;
+  const size_t length = mDumpPending.Length();
+  auto dropPending = MakeScopeExit([&] { DumpDropPending(); });
+
+  if (mDumpExt.EqualsLiteral("mp4") &&
+      SegmentHasEmptySample(mDumpPending.Elements(), length)) {
+    MSE_DEBUG("Dump: dropping a segment with a zero-size sample");
+    mDumpEmptySegments++;
+    return;
+  }
+  if (!DumpSegmentRange(start, end)) {
+    MSE_DEBUG("Dump: segment of {} bytes without readable times", length);
+  }
+  const bool known = start >= 0 && end > start;
+
+  // Segments normally follow each other exactly; anything beyond this is a
+  // seek or a live-stream discontinuity and starts a new part.
+  static const int64_t kGapToleranceUs = 1000000;
+  const media::TimeUnit fuzz = media::TimeUnit::FromMicroseconds(100000);
+  if (known) {
+    media::TimeInterval range(media::TimeUnit::FromMicroseconds(start),
+                              media::TimeUnit::FromMicroseconds(end), fuzz);
+    // Recorded already (seek back, re-buffering after a rendition switch).
+    if (mDumpRecorded.Contains(range)) {
+      MSE_DEBUG("Dump: segment [{}, {}] recorded before, skipping", start,
+                end);
+      mDumpSkippedSegments++;
+      return;
+    }
+    if (mDumpFile && !mDumpNeedPart && mDumpPartLastEndUs >= 0 &&
+        (start > mDumpPartLastEndUs + kGapToleranceUs ||
+         start < mDumpPartLastStartUs - kGapToleranceUs)) {
+      MSE_DEBUG("Dump: segment [{}, {}] after [{}, {}], new part", start,
+                end, mDumpPartLastStartUs, mDumpPartLastEndUs);
+      mDumpNeedPart = true;
+    }
+  }
+  if (mDumpNeedPart || !mDumpFile) {
+    // ffmpeg's stream copy drops the video before the first keyframe but
+    // keeps the audio of those frames, which would put the picture ahead of
+    // the sound by up to a GOP: a part starts at a keyframe.
+    if (!DumpSegmentStartsWithKeyframe()) {
+      MSE_DEBUG("Dump: segment [{}, {}] does not start with a keyframe, "
+                "waiting for one",
+                start, end);
+      mDumpKeyframeWaits++;
+      return;
+    }
+    if (!DumpOpenPart()) {
+      return;
+    }
+  }
+  DumpWriteBytes(mDumpPending.Elements(), length);
+  if (!known) {
+    return;
+  }
+  // Touching segments merge into one interval (the fuzz absorbs the
+  // rounding of per-track clocks).
+  mDumpRecorded += media::TimeInterval(
+      media::TimeUnit::FromMicroseconds(start),
+      media::TimeUnit::FromMicroseconds(end),
+      media::TimeUnit::FromMicroseconds(50000));
+  mDumpPartLastStartUs = start;
+  mDumpPartLastEndUs = end;
+  if (mDumpStartUs < 0 || start < mDumpStartUs) {
+    mDumpStartUs = start;
+  }
+  if (end > mDumpEndUs) {
+    mDumpEndUs = end;
+  }
+  int64_t recordedUs = 0;
+  for (const auto& interval : mDumpRecorded) {
+    recordedUs += interval.Length().ToMicroseconds();
+  }
+  mDumpRecordedUs = recordedUs;
+}
+
+void TrackBuffersManager::DumpWriteBytes(const uint8_t* aData,
+                                         size_t aLength) {
+  if (!aLength || !mDumpFile) {
+    return;
+  }
+  size_t written = fwrite(aData, 1, aLength, mDumpFile);
+  // Keep the file complete on disk even while it stays open.
+  fflush(mDumpFile);
+  mDumpBytes += written;
+  if (written != aLength) {
+    MSE_DEBUG("Dump: short write ({} of {})", written, aLength);
+    mDumpError = true;
+  }
+}
+
+void TrackBuffersManager::DumpClose() {
+  if (mDumpFile) {
+    fclose(mDumpFile);
+    mDumpFile = nullptr;
+  }
+}
 
