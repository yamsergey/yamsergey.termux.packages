+// ---- Termux patch 0034: the segment readers the dump relies on -------------
+namespace {
+
+uint32_t ReadU32(const uint8_t* aData, size_t aPos) {
+  return uint32_t(aData[aPos]) << 24 | uint32_t(aData[aPos + 1]) << 16 |
+         uint32_t(aData[aPos + 2]) << 8 | uint32_t(aData[aPos + 3]);
+}
+
+uint64_t ReadU64(const uint8_t* aData, size_t aPos) {
+  return (uint64_t(ReadU32(aData, aPos)) << 32) | ReadU32(aData, aPos + 4);
+}
+
+constexpr uint32_t Fourcc(const char* aType) {
+  return uint32_t(uint8_t(aType[0])) << 24 | uint32_t(uint8_t(aType[1])) << 16 |
+         uint32_t(uint8_t(aType[2])) << 8 | uint32_t(uint8_t(aType[3]));
+}
+
+// Calls aVisit(type, payloadStart, end) for every ISO BMFF box in
+// [aPos, aEnd). A full box's version and flags are the payload's first bytes.
+template <typename F>
+void ForEachBox(const uint8_t* aData, size_t aPos, size_t aEnd, F&& aVisit) {
+  while (aPos + 8 <= aEnd) {
+    uint64_t size = ReadU32(aData, aPos);
+    size_t header = 8;
+    if (size == 1) {
+      if (aPos + 16 > aEnd) {
+        return;
+      }
+      size = ReadU64(aData, aPos + 8);
+      header = 16;
+    } else if (size == 0) {
+      size = aEnd - aPos;
+    }
+    if (size < header || size > aEnd - aPos) {
+      return;
+    }
+    aVisit(ReadU32(aData, aPos + 4), aPos + header, size_t(aPos + size));
+    aPos += size_t(size);
+  }
+}
+
+int64_t TicksToUs(uint64_t aTicks, uint64_t aScale) {
+  return int64_t((aTicks / aScale) * 1000000 +
+                 (aTicks % aScale) * 1000000 / aScale);
+}
+
+// The tracks of an fMP4 init segment: track_ID, mdhd timescale, hdlr type
+// and the trex default sample duration and flags. The timescales differ per track (90 kHz video
+// next to 48 kHz audio is common), which is why the segments' times are read
+// here per track rather than taken from ContainerParser, whose multi-track
+// mode applies one timescale to all of them.
+void ParseMp4Init(const uint8_t* aData, size_t aLength,
+                  nsTArray<TrackBuffersManager::DumpTrack>& aTracks) {
+  struct Default {
+    uint32_t mId;
+    uint32_t mDuration;
+    uint32_t mFlags;
+  };
+  AutoTArray<Default, 2> defaults;
+  ForEachBox(aData, 0, aLength, [&](uint32_t aType, size_t aStart,
+                                    size_t aEnd) {
+    if (aType != Fourcc("moov")) {
+      return;
+    }
+    ForEachBox(aData, aStart, aEnd, [&](uint32_t aType, size_t aStart,
+                                        size_t aEnd) {
+      if (aType == Fourcc("trak")) {
+        TrackBuffersManager::DumpTrack track;
+        ForEachBox(aData, aStart, aEnd, [&](uint32_t aType, size_t aStart,
+                                            size_t aEnd) {
+          if (aType == Fourcc("tkhd") && aStart + 4 <= aEnd) {
+            // version, flags, creation and modification time, track_ID.
+            size_t at = aData[aStart] == 1 ? aStart + 20 : aStart + 12;
+            if (at + 4 <= aEnd) {
+              track.mId = ReadU32(aData, at);
+            }
+          } else if (aType == Fourcc("mdia")) {
+            ForEachBox(aData, aStart, aEnd, [&](uint32_t aType, size_t aStart,
+                                                size_t aEnd) {
+              if (aType == Fourcc("mdhd") && aStart + 4 <= aEnd) {
+                size_t at = aData[aStart] == 1 ? aStart + 20 : aStart + 12;
+                if (at + 4 <= aEnd) {
+                  track.mScale = ReadU32(aData, at);
+                }
+              } else if (aType == Fourcc("hdlr") && aStart + 12 <= aEnd) {
+                // version, flags, pre_defined, handler_type.
+                track.mVideo = ReadU32(aData, aStart + 8) == Fourcc("vide");
+              }
+            });
+          }
+        });
+        if (track.mId && track.mScale) {
+          aTracks.AppendElement(track);
+        }
+      } else if (aType == Fourcc("mvex")) {
+        ForEachBox(aData, aStart, aEnd, [&](uint32_t aType, size_t aStart,
+                                            size_t aEnd) {
+          if (aType == Fourcc("trex") && aStart + 24 <= aEnd) {
+            // version, flags, track_ID, default_sample_description_index,
+            // default_sample_duration, default_sample_size,
+            // default_sample_flags.
+            defaults.AppendElement(Default{ReadU32(aData, aStart + 4),
+                                           ReadU32(aData, aStart + 12),
+                                           ReadU32(aData, aStart + 20)});
+          }
+        });
+      }
+    });
+  });
+  for (const Default& d : defaults) {
+    for (auto& track : aTracks) {
+      if (track.mId == d.mId) {
+        track.mDefaultDuration = d.mDuration;
+        track.mDefaultFlags = d.mFlags;
+      }
+    }
+  }
+}
+
+// The decode time range covered by the fragments of an fMP4 media segment,
+// across all of its tracks.
+bool Mp4SegmentRange(const uint8_t* aData, size_t aLength,
+                     const nsTArray<TrackBuffersManager::DumpTrack>& aTracks,
+                     int64_t& aStartUs, int64_t& aEndUs) {
+  bool found = false;
+  int64_t startUs = INT64_MAX;
+  int64_t endUs = INT64_MIN;
+  ForEachBox(aData, 0, aLength, [&](uint32_t aType, size_t aStart,
+                                    size_t aEnd) {
+    if (aType != Fourcc("moof")) {
+      return;
+    }
+    ForEachBox(aData, aStart, aEnd, [&](uint32_t aType, size_t aStart,
+                                        size_t aEnd) {
+      if (aType != Fourcc("traf")) {
+        return;
+      }
+      const TrackBuffersManager::DumpTrack* track = nullptr;
+      bool haveBase = false;
+      uint64_t base = 0;
+      uint64_t duration = 0;
+      bool haveDefaultDuration = false;
+      uint32_t defaultDuration = 0;
+      ForEachBox(aData, aStart, aEnd, [&](uint32_t aType, size_t aStart,
+                                          size_t aEnd) {
+        if (aType == Fourcc("tfhd") && aStart + 8 <= aEnd) {
+          uint32_t flags = ReadU32(aData, aStart) & 0xffffff;
+          uint32_t id = ReadU32(aData, aStart + 4);
+          for (const auto& t : aTracks) {
+            if (t.mId == id) {
+              track = &t;
+            }
+          }
+          size_t pos = aStart + 8;
+          if (flags & 0x1) pos += 8;  // base_data_offset
+          if (flags & 0x2) pos += 4;  // sample_description_index
+          if ((flags & 0x8) && pos + 4 <= aEnd) {
+            haveDefaultDuration = true;
+            defaultDuration = ReadU32(aData, pos);
+          }
+        } else if (aType == Fourcc("tfdt") && aStart + 8 <= aEnd) {
+          if (aData[aStart] == 1) {
+            if (aStart + 12 > aEnd) {
+              return;
+            }
+            base = ReadU64(aData, aStart + 4);
+          } else {
+            base = ReadU32(aData, aStart + 4);
+          }
+          haveBase = true;
+        } else if (aType == Fourcc("trun") && aStart + 8 <= aEnd) {
+          uint32_t flags = ReadU32(aData, aStart) & 0xffffff;
+          uint32_t count = ReadU32(aData, aStart + 4);
+          size_t pos = aStart + 8;
+          if (flags & 0x1) pos += 4;  // data_offset
+          if (flags & 0x4) pos += 4;  // first_sample_flags
+          size_t perSample = (flags & 0x100 ? 4 : 0) + (flags & 0x200 ? 4 : 0) +
+                             (flags & 0x400 ? 4 : 0) + (flags & 0x800 ? 4 : 0);
+          if (flags & 0x100) {
+            for (uint32_t i = 0; i < count && pos + 4 <= aEnd;
+                 i++, pos += perSample) {
+              duration += ReadU32(aData, pos);
+            }
+          } else if (haveDefaultDuration) {
+            duration += uint64_t(defaultDuration) * count;
+          } else if (track) {
+            duration += uint64_t(track->mDefaultDuration) * count;
+          }
+        }
+      });
+      if (!track || !haveBase || !duration) {
+        return;
+      }
+      startUs = std::min(startUs, TicksToUs(base, track->mScale));
+      endUs = std::max(endUs, TicksToUs(base + duration, track->mScale));
+      found = true;
+    });
+  });
+  if (!found || endUs <= startUs) {
+    return false;
+  }
+  aStartUs = startUs;
+  aEndUs = endUs;
+  return true;
+}
+
+// Sample flags as ffmpeg reads them: a sample is a keyframe unless it is
+// marked non-sync or as depending on other samples.
+constexpr uint32_t kSampleNotKeyframe = 0x01010000;
+
+bool TrackIsVideo(const nsTArray<TrackBuffersManager::DumpTrack>& aTracks,
+                  uint64_t aId) {
+  for (const auto& track : aTracks) {
+    if (track.mId == aId) {
+      return track.mVideo;
+    }
+  }
+  return false;
+}
