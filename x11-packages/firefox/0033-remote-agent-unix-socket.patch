+  // Termux patch (ADR 020): listen on a Unix socket file (mode 0600) instead of a TCP port.
+  _startUnix(path) {
+    if (this._socket) {
+      throw Components.Exception("", Cr.NS_ERROR_ALREADY_INITIALIZED);
+    }
+    this._doQuit = this._socketClosed = false;
+    this._unix = true;
+    this._host = "localhost";
+    this._port = 80;
+    const file = Cc["@mozilla.org/file/local;1"].createInstance(Ci.nsIFile);
+    file.initWithPath(path);
+    if (file.exists()) {
+      file.remove(false);
+    }
+    const socket = Cc["@mozilla.org/network/server-socket;1"].createInstance(
+      Ci.nsIServerSocket
+    );
+    socket.initWithFilename(file, 0o600, 16);
+    socket.asyncListen(this);
+    this._identity._initialize(80, "localhost", true, false);
+    this._socket = socket;
+    dumpn(">>> listening on unix socket " + path);
+  },
