#!/usr/bin/env bash
# Merge the parts of a Firefox media recording (yamsergey.termux.packages
# patches 0034-0037) into one MP4 with ffmpeg.
#
#   termux-firefox-recording-merge [-o out.mp4] <recording>
#
# <recording> is one of the part files, the .json summary, or the common
# prefix "<dir>/<time>-<host>" of a recording. Parts of one track are
# concatenated (stream copy), then video and audio are muxed together.
#
# Limits: overlapping ranges from seeks are not removed, and a quality switch
# in the middle of a recording gives a file whose resolution changes mid-way;
# re-encode with ffmpeg if a player does not like that.
set -euo pipefail

out=""
while getopts "o:h" opt; do
	case "$opt" in
	o) out="$OPTARG" ;;
	*) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
	esac
done
shift $((OPTIND - 1))
[ $# -eq 1 ] || { echo "usage: $(basename "$0") [-o out.mp4] <recording>" >&2; exit 2; }

input="$1"
# Reduce whatever we got to the common prefix "<dir>/<time>-<host>".
prefix="$input"
prefix="${prefix%.json}"
prefix="$(printf '%s' "$prefix" | sed -E 's/-(video|audio)-[0-9]+-p[0-9]{3}\.(mp4|webm)$//')"
dir="$(dirname "$prefix")"
base="$(basename "$prefix")"
[ -n "$out" ] || out="$prefix.mp4"

command -v ffmpeg >/dev/null || { echo "ffmpeg is not installed (pkg install ffmpeg)" >&2; exit 1; }

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

concat_track() { # kind -> prints the merged file path, or nothing
	local kind="$1" list="$tmp/$1.txt" merged="$tmp/$1.mp4" f
	local -a files=()
	for f in "$dir/$base-$kind-"*-p[0-9][0-9][0-9].*; do
		[ -s "$f" ] && files+=("$f")
	done
	[ "${#files[@]}" -gt 0 ] || return 0
	if [ "${#files[@]}" -eq 1 ]; then
		ffmpeg -nostdin -loglevel error -y -i "${files[0]}" -c copy "$merged"
	else
		: > "$list"
		for f in "${files[@]}"; do
			printf "file '%s'\n" "$(printf '%s' "$f" | sed "s/'/'\\\\''/g")" >> "$list"
		done
		ffmpeg -nostdin -loglevel error -y -f concat -safe 0 -i "$list" -c copy "$merged"
	fi
	echo "$merged"
}

video="$(concat_track video)"
audio="$(concat_track audio)"

if [ -z "$video" ] && [ -z "$audio" ]; then
	echo "no parts found for $prefix" >&2
	exit 1
fi

inputs=()
[ -n "$video" ] && inputs+=(-i "$video")
[ -n "$audio" ] && inputs+=(-i "$audio")
ffmpeg -nostdin -loglevel error -y "${inputs[@]}" -c copy -movflags +faststart "$out"
echo "$out"
