--- /dev/null
+++ b/browser/components/termux/TermuxRecordingUI.sys.mjs
@@ -0,0 +1,686 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Termux media recording toolbar button (yamsergey.termux.packages patch
+ * 0037). One CustomizableUI button in the nav-bar, shown only while the
+ * selected tab has a streamed (MSE) video, red while recording; its popover
+ * starts, pauses and stops the recording kept by TermuxMediaRecording.
+ */
+
+const lazy = {};
+
+ChromeUtils.defineESModuleGetters(lazy, {
+  CustomizableUI:
+    "moz-src:///browser/components/customizableui/CustomizableUI.sys.mjs",
+  TermuxMediaRecording:
+    "moz-src:///toolkit/components/termux/TermuxMediaRecording.sys.mjs",
+});
+
+const WIDGET_ID = "termux-record-button";
+
+// Colours of the popover from the design tokens, so that it follows the
+// light or dark scheme of the browser; the values after the comma are for a
+// window without the tokens.
+const ACCENT = "var(--color-accent-primary, #0060df)";
+const ERROR_TEXT = "var(--text-color-error, #e22850)";
+const BUTTON_PRIMARY =
+  "border: 1px solid var(--button-border-color-primary, transparent); " +
+  "background: var(--button-background-color-primary, #0060df); " +
+  "color: var(--button-text-color-primary, #fff);";
+const BUTTON =
+  "border: 1px solid var(--button-border-color, color-mix(in srgb, currentColor 30%, transparent)); " +
+  "background: var(--button-background-color, transparent); " +
+  "color: var(--button-text-color, inherit);";
+const PANEL_ID = "termux-record-panel";
+const HTML_NS = "http://www.w3.org/1999/xhtml";
+
+function svgIcon(body) {
+  return (
+    "data:image/svg+xml," +
+    encodeURIComponent(
+      `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16">${body}</svg>`
+    )
+  );
+}
+
+const ICON_IDLE = svgIcon(
+  '<path fill="context-fill" fill-opacity="context-fill-opacity" d="M8 1a7 7 0 1 1 0 14A7 7 0 0 1 8 1zm0 1.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11z"/>' +
+    '<circle fill="context-fill" fill-opacity="context-fill-opacity" cx="8" cy="8" r="2.5"/>'
+);
+const ICON_REC = svgIcon(
+  '<path fill="#e22850" d="M8 1a7 7 0 1 1 0 14A7 7 0 0 1 8 1zm0 1.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11z"/>' +
+    '<circle fill="#e22850" cx="8" cy="8" r="3.5"/>'
+);
+const ICON_PAUSED = svgIcon(
+  '<path fill="context-fill" fill-opacity="context-fill-opacity" d="M8 1a7 7 0 1 1 0 14A7 7 0 0 1 8 1zm0 1.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11z"/>' +
+    '<rect fill="context-fill" fill-opacity="context-fill-opacity" x="5.5" y="5" width="2" height="6"/>' +
+    '<rect fill="context-fill" fill-opacity="context-fill-opacity" x="8.5" y="5" width="2" height="6"/>'
+);
+
+const ICON_DONE = svgIcon(
+  '<circle fill="#2ac3a2" cx="8" cy="8" r="7"/>' +
+    '<path fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="m4.8 8.2 2.2 2.2 4.2-4.6"/>'
+);
+const ICON_FAILED = svgIcon(
+  '<circle fill="#e22850" cx="8" cy="8" r="7"/>' +
+    '<path fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" d="M8 4.5v4.2M8 11.2v.3"/>'
+);
+
+// A ring that fills with the merge progress (0..1).
+function savingIcon(progress) {
+  const length = 2 * Math.PI * 5.5;
+  const filled = (length * Math.min(1, Math.max(0, progress))).toFixed(2);
+  return svgIcon(
+    '<circle fill="none" stroke="context-fill" stroke-opacity="0.3" stroke-width="2.5" cx="8" cy="8" r="5.5"/>' +
+      `<circle fill="none" stroke="#0a84ff" stroke-width="2.5" cx="8" cy="8" r="5.5" stroke-dasharray="${filled} ${length.toFixed(2)}" transform="rotate(-90 8 8)"/>`
+  );
+}
+
+// What the merge is doing now, from the state's stage.
+export function describeStage(stage) {
+  const of = stage && stage.count > 1 ? ` ${stage.index} of ${stage.count}` : "";
+  switch (stage?.name) {
+    case "measuring":
+      return stage.count ? `Checking part${of}` : "Preparing";
+    case "rescaling":
+      return `Re-encoding part${of} to the main picture size`;
+    case "joining":
+      return `Joining the ${stage.kind ? `${stage.kind} ` : ""}parts`;
+    case "writing":
+      return "Writing the file";
+  }
+  return "Preparing";
+}
+
+function finished(status) {
+  return status === "ready" || status === "partial" || status === "error";
+}
+
+// One recording, also after its tab is gone.
+function recordingKey(state) {
+  return `${state.browsingContextId}:${state.startedAt}`;
+}
+
+export function formatTime(ms) {
+  const total = Math.max(0, Math.round(ms / 1000));
+  const h = Math.floor(total / 3600);
+  const m = Math.floor((total % 3600) / 60);
+  const s = total % 60;
+  const mm = String(m).padStart(2, "0");
+  const ss = String(s).padStart(2, "0");
+  return h ? `${h}:${mm}:${ss}` : `${mm}:${ss}`;
+}
+
+export function formatBytes(bytes) {
+  if (bytes >= 1024 * 1024 * 1024) {
+    return `${(bytes / (1024 * 1024 * 1024)).toFixed(2)} GB`;
+  }
+  if (bytes >= 1024 * 1024) {
+    return `${Math.round(bytes / (1024 * 1024))} MB`;
+  }
+  return `${Math.round(bytes / 1024)} KB`;
+}
+
+function describeTrack(track) {
+  if (track.kind === "video") {
+    const size =
+      track.width && track.height ? `${track.width}×${track.height}` : "";
+    return ["Video", size, track.codec || track.mime].filter(Boolean).join(" · ");
+  }
+  const audio = [];
+  if (track.channels) {
+    audio.push(`${track.channels} ch`);
+  }
+  if (track.rate) {
+    audio.push(`${Math.round(track.rate / 1000)} kHz`);
+  }
+  return ["Audio", audio.join(", "), track.codec || track.mime]
+    .filter(Boolean)
+    .join(" · ");
+}
+
+export const TermuxRecordingUI = {
+  _inited: false,
+  _windows: new Set(),
+  _entries: new WeakMap(),
+  // Recordings whose merge finished while nobody looked (recordingKey).
+  _unseen: new Set(),
+  _saving: new Set(),
+
+  init() {
+    if (this._inited) {
+      return;
+    }
+    this._inited = true;
+
+    lazy.CustomizableUI.createWidget({
+      id: WIDGET_ID,
+      type: "button",
+      defaultArea: lazy.CustomizableUI.AREA_NAVBAR,
+      localized: false,
+      label: "Record media",
+      tooltiptext: "Record media on this page",
+      overflows: false,
+      removable: true,
+      onCreated: node => this._onWidgetCreated(node),
+      onCommand: event => this._onCommand(event),
+    });
+
+    this._onState = state => {
+      if (state?.startedAt) {
+        const key = recordingKey(state);
+        if (state.status === "saving") {
+          this._saving.add(key);
+        } else if (this._saving.delete(key) && finished(state.status)) {
+          this._unseen.add(key);
+        } else if (!finished(state.status)) {
+          this._unseen.delete(key);
+        }
+      }
+      this._updateAll();
+    };
+    lazy.TermuxMediaRecording.on("stream-detected", this._onState);
+    lazy.TermuxMediaRecording.on("state-changed", this._onState);
+
+    // Merges cut short by the last run of the browser go on, shown like any
+    // other recording being saved.
+    ChromeUtils.idleDispatch(
+      () => {
+        lazy.TermuxMediaRecording.resumeInterruptedMerges().catch(
+          console.error
+        );
+      },
+      { timeout: 10000 }
+    );
+  },
+
+  _onWidgetCreated(node) {
+    const win = node.ownerDocument.defaultView;
+    node.setAttribute("image", ICON_IDLE);
+    node.hidden = true;
+    this._entries.set(win, { node, panel: null });
+    this._windows.add(win);
+    win.addEventListener(
+      "unload",
+      () => {
+        this._windows.delete(win);
+      },
+      { once: true }
+    );
+
+    const attach = () => {
+      win.gBrowser?.tabContainer.addEventListener("TabSelect", () =>
+        this._updateWindow(win)
+      );
+      this._updateWindow(win);
+    };
+    if (win.gBrowserInit?.delayedStartupFinished) {
+      attach();
+    } else {
+      const observer = subject => {
+        if (subject === win) {
+          Services.obs.removeObserver(
+            observer,
+            "browser-delayed-startup-finished"
+          );
+          attach();
+        }
+      };
+      Services.obs.addObserver(observer, "browser-delayed-startup-finished");
+    }
+  },
+
+  _onCommand(event) {
+    const node = event.target;
+    const win = node.ownerDocument.defaultView;
+    const entry = this._entries.get(win);
+    if (!entry) {
+      return;
+    }
+    const panel = this._ensurePanel(win, entry);
+    if (panel.state === "open" || panel.state === "showing") {
+      panel.hidePopup();
+      return;
+    }
+    this._render(win, entry);
+    panel.openPopup(node, "bottomright topright", 0, 0, false, false);
+  },
+
+  _updateAll() {
+    for (const win of this._windows) {
+      this._updateWindow(win);
+    }
+  },
+
+  _currentState(win) {
+    const browsingContext = win.gBrowser?.selectedBrowser?.browsingContext;
+    return browsingContext
+      ? lazy.TermuxMediaRecording.getState(browsingContext)
+      : null;
+  },
+
+  /**
+   * Recordings of other tabs (or of closed ones) that are merging now or
+   * finished unseen, so that a merge can be followed from any tab.
+   */
+  _others(state) {
+    const own = state?.startedAt ? recordingKey(state) : null;
+    return lazy.TermuxMediaRecording.listRecordings().filter(other => {
+      const key = recordingKey(other);
+      return (
+        key !== own &&
+        (other.status === "saving" ||
+          (finished(other.status) && this._unseen.has(key)))
+      );
+    });
+  },
+
+  _updateWindow(win) {
+    const entry = this._entries.get(win);
+    if (!entry || win.closed) {
+      return;
+    }
+    const state = this._currentState(win);
+    const others = this._others(state);
+    const status = state?.status || "idle";
+    const unseen = state?.startedAt && this._unseen.has(recordingKey(state));
+    const show =
+      (!!state && (state.tracks.length > 0 || status !== "idle")) ||
+      others.length > 0;
+    entry.node.hidden = !show;
+    let icon = ICON_IDLE;
+    let tooltip = "Record media on this page";
+    const otherSaving = others.find(other => other.status === "saving");
+    const otherDone = others.find(other => other.status !== "saving");
+    if (status === "recording") {
+      icon = ICON_REC;
+      tooltip = `Recording · ${formatTime(state.capturedMs)} · ${formatBytes(state.bytes)}`;
+    } else if (status === "paused") {
+      icon = ICON_PAUSED;
+      tooltip = "Recording paused";
+    } else if (status === "saving" || otherSaving) {
+      const saving = status === "saving" ? state : otherSaving;
+      icon = savingIcon(saving.progress);
+      tooltip = `Saving recording · ${Math.round(saving.progress * 100)}% · ${describeStage(saving.stage)}`;
+    } else if ((unseen && finished(status)) || otherDone) {
+      const done = unseen && finished(status) ? state : otherDone;
+      icon = done.status === "error" ? ICON_FAILED : ICON_DONE;
+      tooltip =
+        done.status === "error"
+          ? `Recording failed: ${done.error || "unknown error"}`
+          : `Recording saved · ${done.output || done.dir}`;
+    }
+    if (entry.node.getAttribute("image") !== icon) {
+      entry.node.setAttribute("image", icon);
+    }
+    entry.node.setAttribute("tooltiptext", tooltip);
+    if (entry.panel && entry.panel.state === "open") {
+      this._render(win, entry);
+    }
+  },
+
+  _ensurePanel(win, entry) {
+    const doc = win.document;
+    let panel = doc.getElementById(PANEL_ID);
+    if (!panel) {
+      panel = doc.createXULElement("panel");
+      panel.id = PANEL_ID;
+      panel.setAttribute("type", "arrow");
+      panel.setAttribute("orient", "vertical");
+      panel.setAttribute("noautofocus", "true");
+      const content = doc.createElementNS(HTML_NS, "div");
+      content.id = `${PANEL_ID}-content`;
+      content.style.cssText =
+        "width: 340px; padding: 14px; display: flex; flex-direction: column; gap: 12px; font: message-box; font-size: 13px;";
+      panel.appendChild(content);
+      doc.getElementById("mainPopupSet").appendChild(panel);
+    }
+    entry.panel = panel;
+    return panel;
+  },
+
+  /** Opens a saved recording in a new tab. */
+  _play(win, path) {
+    win.openTrustedLinkIn(PathUtils.toFileURI(path), "tab");
+  },
+
+  _el(doc, tag, style, text) {
+    const el = doc.createElementNS(HTML_NS, tag);
+    if (style) {
+      el.style.cssText = style;
+    }
+    if (text !== undefined) {
+      el.textContent = text;
+    }
+    return el;
+  },
+
+  _button(doc, label, primary, onClick) {
+    const button = this._el(
+      doc,
+      "button",
+      `min-height: 32px; padding: 0 14px; border-radius: 6px; font: inherit; font-weight: 600; cursor: pointer;` +
+        (primary ? BUTTON_PRIMARY : BUTTON),
+      label
+    );
+    button.addEventListener("click", onClick);
+    return button;
+  },
+
+  _render(win, entry) {
+    const doc = win.document;
+    const panel = this._ensurePanel(win, entry);
+    const content = panel.firstElementChild;
+    const browsingContext = win.gBrowser?.selectedBrowser?.browsingContext;
+    const state = this._currentState(win);
+    content.replaceChildren();
+    if (!browsingContext) {
+      return;
+    }
+
+    const status = state?.status || "idle";
+    const muted = "opacity: 0.7; font-size: 12px;";
+    const row = (gap = 10) =>
+      this._el(doc, "div", `display: flex; align-items: center; gap: ${gap}px;`);
+
+    // Header
+    let title = "Record media on this page";
+    let subtitle = "Saves the video as it streams, then merges it into one file.";
+    if (state?.encrypted && status !== "recording" && status !== "paused") {
+      title = "This video can't be recorded";
+      subtitle =
+        "The stream is protected with DRM. Firefox only receives encrypted data for it, so a recording would not play.";
+    } else if (status === "recording") {
+      title = "Recording";
+      subtitle = state.origin || "";
+    } else if (status === "paused") {
+      title = "Recording paused";
+      subtitle = state.origin || "";
+    } else if (status === "saving") {
+      title = "Saving recording";
+      subtitle = describeStage(state.stage);
+    } else if (status === "ready" || status === "partial") {
+      title = status === "ready" ? "Recording saved" : "Recording saved (the page closed early)";
+      subtitle = state.output
+        ? `${state.output}${state.outputBytes ? ` · ${formatBytes(state.outputBytes)}` : ""}`
+        : state.dir;
+    } else if (status === "error") {
+      title = "Recording failed";
+      subtitle = state.error || "Unknown error";
+    }
+    const header = this._el(
+      doc,
+      "div",
+      "display: flex; flex-direction: column; gap: 4px;"
+    );
+    header.appendChild(
+      this._el(doc, "h2", "margin: 0; font-size: 15px; font-weight: 600;", title)
+    );
+    header.appendChild(this._el(doc, "span", muted, subtitle));
+    content.appendChild(header);
+
+    // Merge progress
+    if (state && status === "saving") {
+      const bar = this._el(
+        doc,
+        "div",
+        "height: 6px; border-radius: 3px; overflow: hidden; background: color-mix(in srgb, currentColor 12%, transparent);"
+      );
+      bar.appendChild(
+        this._el(
+          doc,
+          "div",
+          `height: 6px; width: ${Math.round(state.progress * 100)}%; background: ${ACCENT}; border-radius: 3px;`
+        )
+      );
+      content.appendChild(bar);
+      const elapsedMs = Date.now() - (state.mergeStartedAt || Date.now());
+      let timing = `${formatTime(elapsedMs)} elapsed`;
+      // The estimate is only shown once the measuring is over and the bar
+      // moved enough to say something.
+      if (state.stage?.name !== "measuring" && state.progress >= 0.15) {
+        const leftMs = (elapsedMs * (1 - state.progress)) / state.progress;
+        timing += ` · about ${formatTime(leftMs)} left`;
+      }
+      const line = row();
+      line.style.justifyContent = "space-between";
+      line.appendChild(this._el(doc, "span", muted, timing));
+      line.appendChild(
+        this._el(
+          doc,
+          "span",
+          "font-size: 12px; font-weight: 600; font-variant-numeric: tabular-nums;",
+          `${Math.round(state.progress * 100)}%`
+        )
+      );
+      content.appendChild(line);
+    }
+    if (state?.startedAt && finished(status)) {
+      this._unseen.delete(recordingKey(state));
+    }
+
+    // Other tabs' recordings that are merging or finished unseen
+    const others = this._others(state);
+    if (others.length) {
+      const list = this._el(
+        doc,
+        "div",
+        "display: flex; flex-direction: column; gap: 6px;"
+      );
+      list.appendChild(
+        this._el(doc, "span", "font-size: 11px; opacity: 0.7; text-transform: uppercase;", "Other recordings")
+      );
+      for (const other of others) {
+        const item = this._el(
+          doc,
+          "div",
+          "display: flex; flex-direction: column; gap: 6px; padding: 8px 10px; border-radius: 6px; background: color-mix(in srgb, currentColor 8%, transparent);"
+        );
+        const head = row(8);
+        head.appendChild(
+          this._el(doc, "span", "flex: 1; min-width: 0; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;", other.title || other.origin || "Recording")
+        );
+        let detail;
+        if (other.status === "saving") {
+          detail = `${Math.round(other.progress * 100)}%`;
+        } else if (other.status === "error") {
+          detail = "Failed";
+        } else {
+          detail = other.outputBytes ? `Saved · ${formatBytes(other.outputBytes)}` : "Saved";
+        }
+        head.appendChild(this._el(doc, "span", muted, detail));
+        item.appendChild(head);
+        if (other.status === "saving") {
+          const bar = this._el(
+            doc,
+            "div",
+            "height: 4px; border-radius: 2px; overflow: hidden; background: color-mix(in srgb, currentColor 12%, transparent);"
+          );
+          bar.appendChild(
+            this._el(
+              doc,
+              "div",
+              `height: 4px; width: ${Math.round(other.progress * 100)}%; background: ${ACCENT}; border-radius: 2px;`
+            )
+          );
+          item.appendChild(bar);
+          item.appendChild(this._el(doc, "span", muted, describeStage(other.stage)));
+        } else if (other.status === "error") {
+          item.appendChild(this._el(doc, "span", `font-size: 12px; color: ${ERROR_TEXT};`, other.error || "Unknown error"));
+        } else if (other.output) {
+          const play = this._el(
+            doc,
+            "a",
+            `font-size: 12px; color: ${ACCENT}; cursor: pointer; text-decoration: underline;`,
+            "Play"
+          );
+          play.addEventListener("click", () => this._play(win, other.output));
+          item.appendChild(play);
+        }
+        if (other.status !== "saving") {
+          // Shown once; the button goes back to this tab's own state.
+          this._unseen.delete(recordingKey(other));
+        }
+        list.appendChild(item);
+      }
+      content.appendChild(list);
+    }
+
+    // Live stats
+    if (state && (status === "recording" || status === "paused")) {
+      const grid = this._el(
+        doc,
+        "div",
+        "display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px;"
+      );
+      for (const [label, value] of [
+        ["Captured", formatTime(state.capturedMs)],
+        ["Size", formatBytes(state.bytes)],
+        ["Parts", String(state.parts)],
+      ]) {
+        const cell = this._el(
+          doc,
+          "div",
+          "display: flex; flex-direction: column; gap: 2px; padding: 8px 10px; border-radius: 6px; background: color-mix(in srgb, currentColor 8%, transparent);"
+        );
+        cell.appendChild(
+          this._el(doc, "span", "font-size: 11px; opacity: 0.7; text-transform: uppercase;", label)
+        );
+        cell.appendChild(
+          this._el(doc, "span", "font-size: 17px; font-weight: 600; font-variant-numeric: tabular-nums;", value)
+        );
+        grid.appendChild(cell);
+      }
+      content.appendChild(grid);
+    }
+
+    // Tracks
+    if (state?.tracks.length) {
+      const list = this._el(
+        doc,
+        "div",
+        "display: flex; flex-direction: column; gap: 6px;"
+      );
+      for (const track of state.tracks) {
+        const line = row();
+        line.style.cssText +=
+          "padding: 8px 10px; border-radius: 6px; background: color-mix(in srgb, currentColor 8%, transparent);";
+        const text = this._el(doc, "div", "display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0;");
+        text.appendChild(
+          this._el(doc, "span", "font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;", describeTrack(track))
+        );
+        const details = [];
+        if (track.encrypted) {
+          details.push("Encrypted");
+        }
+        if (track.parts) {
+          details.push(`${track.parts} part${track.parts === 1 ? "" : "s"}`);
+        }
+        if (track.bytes) {
+          details.push(formatBytes(track.bytes));
+        }
+        text.appendChild(this._el(doc, "span", muted, details.join(" · ") || " "));
+        line.appendChild(text);
+        list.appendChild(line);
+      }
+      content.appendChild(list);
+    }
+
+    // Error line
+    if (state?.error && status !== "error") {
+      content.appendChild(
+        this._el(doc, "span", `font-size: 12px; color: ${ERROR_TEXT};`, state.error)
+      );
+    }
+
+    // Options and footer for the idle and finished states
+    const idleLike =
+      status === "idle" ||
+      status === "ready" ||
+      status === "partial" ||
+      status === "error";
+    if (!state?.encrypted && idleLike) {
+      const dir = Services.prefs.getStringPref("media.termux.recording.dir", "");
+      content.appendChild(
+        this._el(doc, "span", muted, dir ? `Saves to ${dir}` : "media.termux.recording.dir is not set")
+      );
+    }
+
+    if (status === "recording" || status === "paused") {
+      content.appendChild(
+        this._el(doc, "span", muted, "Keeps recording while you browse other tabs. Closing this tab stops and saves what was captured.")
+      );
+    } else if (status === "saving") {
+      content.appendChild(
+        this._el(doc, "span", muted, "The parts are kept until the merge finishes, so nothing is lost if Firefox closes.")
+      );
+    } else if (status === "error" && state?.files.length) {
+      content.appendChild(
+        this._el(doc, "span", muted, `The ${state.files.length} recorded part${state.files.length === 1 ? " is" : "s are"} kept in ${state.dir}.`)
+      );
+    }
+
+    // Buttons
+    const buttons = this._el(
+      doc,
+      "div",
+      "display: flex; gap: 8px; justify-content: flex-end; align-items: center; padding-top: 2px;"
+    );
+    const close = () => panel.hidePopup();
+    const library = this._el(
+      doc,
+      "a",
+      `margin-inline-end: auto; font-size: 12px; color: ${ACCENT}; cursor: pointer; text-decoration: underline;`,
+      "All recordings"
+    );
+    library.addEventListener("click", () => {
+      close();
+      win.switchToTabHavingURI("about:recordings", true);
+    });
+    buttons.appendChild(library);
+    const recorder = lazy.TermuxMediaRecording;
+    if (status === "saving") {
+      buttons.appendChild(this._button(doc, "Close", true, close));
+    } else if (state?.encrypted && status !== "recording" && status !== "paused") {
+      buttons.appendChild(this._button(doc, "Close", true, close));
+    } else if (status === "recording") {
+      buttons.appendChild(
+        this._button(doc, "Pause", false, () => recorder.pause(browsingContext))
+      );
+      buttons.appendChild(
+        this._button(doc, "Stop and save", true, () => {
+          recorder.stop(browsingContext).catch(console.error);
+        })
+      );
+    } else if (status === "paused") {
+      buttons.appendChild(
+        this._button(doc, "Stop and save", false, () => {
+          recorder.stop(browsingContext).catch(console.error);
+        })
+      );
+      buttons.appendChild(
+        this._button(doc, "Resume", true, () => recorder.resume(browsingContext))
+      );
+    } else {
+      buttons.appendChild(
+        this._button(doc, status === "idle" ? "Cancel" : "Close", false, close)
+      );
+      if ((status === "ready" || status === "partial") && state.output) {
+        buttons.appendChild(
+          this._button(doc, "Play", false, () => {
+            close();
+            this._play(win, state.output);
+          })
+        );
+      }
+      buttons.appendChild(
+        this._button(doc, status === "idle" ? "Start recording" : "Record again", true, () => {
+          recorder.start(browsingContext).catch(console.error);
+        })
+      );
+    }
+    content.appendChild(buttons);
+  },
+};
