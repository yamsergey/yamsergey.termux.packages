+
+.state.error {
+  color: var(--text-color-error);
+}
+
+.state .line {
+  display: flex;
+  justify-content: space-between;
+  gap: 8px;
+}
+
+.state .percent {
+  font-weight: 600;
+  font-variant-numeric: tabular-nums;
+}
+
+.bar {
+  height: 4px;
+  border-radius: 2px;
+  overflow: hidden;
+  background: color-mix(in srgb, currentColor 15%, transparent);
+}
+
+.bar > div {
+  height: 4px;
+  border-radius: 2px;
+  background: var(--color-accent-primary);
+}
+
+.size {
+  width: 140px;
+  text-align: end;
+  font-variant-numeric: tabular-nums;
+  font-size: 0.9em;
+}
+
+.actions {
+  display: flex;
+  gap: 6px;
+  flex-wrap: wrap;
+}
+
+.actions button {
+  margin: 0;
+}
+
+@media (max-width: 640px) {
+  .state,
+  .size {
+    width: auto;
+    text-align: start;
+  }
