+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// about:recordings: the recordings in the recording directory, and the ones
+// running or being merged now. Runs with chrome privileges; every text that
+// comes from a recorded page (its title, its address) is set as text only.
+
+const { TermuxMediaRecording } = ChromeUtils.importESModule(
+  "moz-src:///toolkit/components/termux/TermuxMediaRecording.sys.mjs"
+);
+const { describeStage, formatBytes, formatTime } = ChromeUtils.importESModule(
+  "moz-src:///browser/components/termux/TermuxRecordingUI.sys.mjs"
+);
+
+const LIVE = new Set(["recording", "paused", "saving"]);
+
+function el(tag, className, text) {
+  const node = document.createElement(tag);
+  if (className) {
+    node.className = className;
+  }
+  if (text !== undefined) {
+    node.textContent = text;
+  }
+  return node;
+}
+
+function button(label, onClick, primary = false) {
+  const node = el("button", primary ? "primary" : "", label);
+  node.addEventListener("click", onClick);
+  return node;
+}
+
+function bar(progress) {
+  const outer = el("div", "bar");
+  const inner = el("div");
+  inner.style.width = `${Math.round(progress * 100)}%`;
+  outer.appendChild(inner);
+  return outer;
+}
+
+function formatDate(ms) {
+  if (!ms) {
+    return "";
+  }
+  const date = new Date(ms);
+  const time = date.toLocaleTimeString(undefined, {
+    hour: "2-digit",
+    minute: "2-digit",
+  });
+  const today = new Date();
+  const yesterday = new Date(today);
+  yesterday.setDate(today.getDate() - 1);
+  if (date.toDateString() === today.toDateString()) {
+    return `today, ${time}`;
+  }
+  if (date.toDateString() === yesterday.toDateString()) {
+    return `yesterday, ${time}`;
+  }
+  return `${date.toLocaleDateString(undefined, { day: "numeric", month: "short" })}, ${time}`;
+}
+
+function describeSizes(sizes) {
+  const heights = [
+    ...new Set(sizes.map(size => Number(size.split("x")[1])).filter(Boolean)),
+  ].sort((a, b) => b - a);
+  return heights.map(h => `${h}p`).join(" and ");
+}
+
+function open(path) {
+  window.browsingContext.topChromeWindow.openTrustedLinkIn(
+    PathUtils.toFileURI(path),
+    "tab"
+  );
+}
+
+function rowFrame(item, live) {
+  const row = el("li", live ? "row live" : "row");
+  const tile = el("div", "tile");
+  if (item.thumbnail) {
+    const img = el("img");
+    img.alt = "";
+    img.addEventListener("error", () => img.remove());
+    img.src = PathUtils.toFileURI(item.thumbnail);
+    tile.appendChild(img);
+  }
+  if (item.capturedMs) {
+    tile.appendChild(el("span", "duration", formatTime(item.capturedMs)));
+  }
+  row.appendChild(tile);
+  const text = el("div", "text");
+  text.appendChild(
+    el("span", "title", item.title || item.origin || "Recording")
+  );
+  text.appendChild(
+    el(
+      "span",
+      "muted",
+      [item.origin, formatDate(item.startedAt), describeSizes(item.sizes || [])]
+        .filter(Boolean)
+        .join(" · ")
+    )
+  );
+  row.appendChild(text);
+  return row;
+}
+
+function liveRow(state) {
+  const sizes = (state.tracks || [])
+    .filter(t => t.kind === "video" && t.width && t.height)
+    .map(t => `${t.width}x${t.height}`);
+  const row = rowFrame({ ...state, sizes }, true);
+  const status = el("div", "state");
+  if (state.status === "saving") {
+    const line = el("div", "line");
+    line.appendChild(el("span", "", describeStage(state.stage)));
+    line.appendChild(
+      el("span", "percent", `${Math.round(state.progress * 100)}%`)
+    );
+    status.appendChild(line);
+    status.appendChild(bar(state.progress));
+  } else {
+    status.appendChild(
+      el(
+        "span",
+        "",
+        state.status === "paused"
+          ? "Paused"
+          : `Recording · ${formatTime(state.capturedMs)}`
+      )
+    );
+  }
+  row.appendChild(status);
+  row.appendChild(el("span", "size", formatBytes(state.bytes || 0)));
+  return row;
+}
+
+function savedRow(item) {
+  const row = rowFrame(item, false);
+  const status = el("div", "state");
+  let label;
+  if (item.encrypted) {
+    label = "Encrypted · won't play";
+  } else if (item.status === "ready") {
+    label = `Ready · ${item.output.endsWith(".webm") ? "WebM" : "MP4"}`;
+  } else if (item.status === "partial") {
+    label = "Partial · the page closed early";
+  } else if (item.status === "unmerged") {
+    label = `Not merged · ${item.parts} part${item.parts === 1 ? "" : "s"}`;
+  } else {
+    label = item.error ? `Failed: ${item.error}` : "Failed";
+    status.classList.add("error");
+  }
+  status.appendChild(el("span", "", label));
+  row.appendChild(status);
+  row.appendChild(
+    el("span", "size", formatBytes(item.outputBytes || item.partBytes || 0))
+  );
+
+  const actions = el("div", "actions");
+  if (item.output) {
+    actions.appendChild(button("Play", () => open(item.output), true));
+  }
+  if (item.parts && !item.output) {
+    actions.appendChild(
+      button(
+        "Merge",
+        () => {
+          TermuxMediaRecording.mergeSavedRecording(item.path)
+            .catch(e => alert(`Cannot merge: ${e.message}`))
+            .finally(refresh);
+        },
+        true
+      )
+    );
+  }
+  actions.appendChild(button("Folder", () => open(item.folder || item.dir)));
+  actions.appendChild(
+    button("Delete", () => {
+      const name = item.title || item.origin || "this recording";
+      const what = item.folder ? "Its folder" : "Its file, summary and parts";
+      if (!confirm(`Delete “${name}”? ${what} will be removed.`)) {
+        return;
+      }
+      TermuxMediaRecording.deleteSavedRecording(item.path)
+        .catch(e => alert(`Cannot delete: ${e.message}`))
+        .finally(refresh);
+    })
+  );
+  row.appendChild(actions);
+  return row;
+}
+
+let saved = [];
+let liveKeys = null;
+let scanning = null;
+
+function liveStates() {
+  return TermuxMediaRecording.listRecordings().filter(state =>
+    LIVE.has(state.status)
+  );
+}
+
+function render() {
+  const live = liveStates();
+  const liveList = document.getElementById("live");
+  liveList.replaceChildren(...live.map(liveRow));
+  liveList.hidden = !live.length;
+  const savedList = document.getElementById("saved");
+  savedList.replaceChildren(...saved.map(savedRow));
+  document.getElementById("empty").hidden = !!(live.length || saved.length);
+
+  const dir = Services.prefs.getStringPref("media.termux.recording.dir", "");
+  const total = saved.reduce(
+    (sum, item) => sum + (item.outputBytes || item.partBytes || 0),
+    0
+  );
+  document.getElementById("summary").textContent = dir
+    ? `Files in ${dir} · ${saved.length} recording${saved.length === 1 ? "" : "s"} · ${formatBytes(total)}`
+    : "media.termux.recording.dir is not set";
+  document.getElementById("open-folder").hidden = !dir;
+}
+
+// Reads the directory again (after a merge, a deletion, or a return to the
+// tab); the live rows are drawn from the recorder's events in between.
+function refresh() {
+  if (!scanning) {
+    scanning = TermuxMediaRecording.listSavedRecordings()
+      .then(rows => {
+        saved = rows;
+      })
+      .catch(console.error)
+      .finally(() => {
+        scanning = null;
+        render();
+      });
+  }
+  return scanning;
+}
+
+function onState() {
+  const keys = liveStates()
+    .map(state => `${state.browsingContextId}:${state.startedAt}:${state.status}`)
+    .join(",");
+  if (keys !== liveKeys) {
+    // A recording started, stopped or finished merging.
+    liveKeys = keys;
+    refresh();
+  } else {
+    render();
+  }
+}
+
+document.addEventListener("DOMContentLoaded", () => {
+  document.getElementById("open-folder").addEventListener("click", () => {
+    open(Services.prefs.getStringPref("media.termux.recording.dir", ""));
+  });
+  TermuxMediaRecording.on("state-changed", onState);
+  window.addEventListener("unload", () =>
+    TermuxMediaRecording.off("state-changed", onState)
+  );
+  document.addEventListener("visibilitychange", () => {
+    if (document.visibilityState === "visible") {
+      refresh();
+    }
+  });
+  onState();
+});
